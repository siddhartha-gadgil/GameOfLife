public import LeanTheory.Theory.Computability.CounterMachineWhile
public import Mathlib.Computability.Halting
public import Mathlib.Computability.PartrecBasis

/-!
# Counter machines compute every partial recursive function

The universality theorem for the counter machines of `CounterMachine.lean` (research note
`N-14`): every partial recursive function `ℕ →. ℕ`, in particular the evaluation of every
`Nat.Partrec.Code`, is computed by a counter program using only `inc`, `decJz` and `halt`.

## Route

Mathlib characterizes partial recursive functions by the vector basis `Nat.Partrec'`
(`Nat.Partrec'.part_iff₁`): functions `List.Vector ℕ n →. ℕ` generated by zero, successor,
projections, composition, primitive recursion (`Nat.Primrec'`) and minimization of a *total*
function. This basis fits register machines directly, an argument per register, and avoids the
pairing function `Nat.pair` (hence square roots) of `Nat.Partrec.Code` altogether. The proof is an
induction over this basis producing statements of the loop language of
`CounterMachineWhile.lean`; the compiler correctness theorem proved there transfers the result to
counter programs.

## Register discipline

`Realizes s f ins out b` says that the statement `s` computes `f` with its arguments in the
registers `ins i`, its result in the register `out`, and scratch space from register `b` on:
whenever the registers from `b` on are zero, `s` terminates iff `f` is defined on the arguments,
and the final register file is **exactly** the initial one with `out` replaced by the value. So
arguments are preserved and the scratch space is zero again, which makes realizations compose
without any bookkeeping of garbage. `Realizable f` asks for such a statement for every placement
with `ins i < b`, `out < b` and `out` different from all `ins i`.

## Main results

* `realizable_zero`, `realizable_succ`, `realizable_get`, `realizable_comp`, `realizable_prec`,
  `realizable_rfind`: closure of `Realizable` under the constructors of the vector basis.
* `realizable_of_primrec'`, `realizable_of_partrec'`.
* `exists_stmt_of_partrec`: a statement taking `Cfg.init n` to `Cfg.init (f n)`.
* `exists_program_eval_eq_of_partrec`: the strong form for counter programs, with the exact
  halting configuration.
* `exists_computes_of_partrec`, `exists_computes_code`: **universality**. For every partial
  recursive `f`, and for `c.eval` for every `c : Nat.Partrec.Code`, there is a well-formed
  program `P` with `P.Computes f`.
* `exists_program_halts_not_computable`: there is a single well-formed counter program whose
  halting set `{n | P halts on input n}` is not computable (from Mathlib's
  `ComputablePred.halting_problem`).

## Sanity checks

* `not_realizes_skip_succ`: `Realizes` is not vacuous: `skip` does not realize the successor.
* `Program.Computes.halts_iff`: halting of a program computing `f` is definedness of `f`.
-/

@[expose] public section

namespace LeanTheory.Computability

open Function Program Stmt

/-- `Realizes s f ins out b`: the statement `s` computes the partial function `f` of `n` arguments,
reading the arguments from the registers `ins i`, writing the value to the register `out`, with
all registers from `b` on as scratch space. Precisely: on every register file that is zero from
`b` on, `s` terminates iff `f` is defined on the arguments, and then the final register file is
the initial one with `out` replaced by the value (in particular the scratch space is zero
again and the arguments are unchanged). -/
def Realizes (s : Stmt) {n : ℕ} (f : List.Vector ℕ n →. ℕ) (ins : Fin n → ℕ) (out b : ℕ) : Prop :=
  ∀ σ σ' : ℕ → ℕ, (∀ x, b ≤ x → σ x = 0) →
    (Exec s σ σ' ↔ ∃ v ∈ f (List.Vector.ofFn fun i => σ (ins i)), σ' = update σ out v)

/-- `Realizable f`: for every placement of the arguments in registers `ins i`, of the result in a
register `out` different from them, and every scratch base `b` above all of these, some statement
realizes `f`. -/
def Realizable {n : ℕ} (f : List.Vector ℕ n →. ℕ) : Prop :=
  ∀ (ins : Fin n → ℕ) (out b : ℕ), (∀ i, ins i < b) → out < b → (∀ i, ins i ≠ out) →
    ∃ s : Stmt, Realizes s f ins out b

/-- Realization of a total function: the unique final state. -/
theorem Realizes.exec_iff {s : Stmt} {n : ℕ} {f : List.Vector ℕ n → ℕ} {ins : Fin n → ℕ}
    {out b : ℕ} (h : Realizes s (f : List.Vector ℕ n →. ℕ) ins out b) {σ σ' : ℕ → ℕ}
    (hσ : ∀ x, b ≤ x → σ x = 0) :
    Exec s σ σ' ↔ σ' = update σ out (f (List.Vector.ofFn fun i => σ (ins i))) := by
  rw [h σ σ' hσ]
  simp

/-- To realize a total function it suffices to exhibit the expected execution. -/
theorem realizes_of_exec {s : Stmt} {n : ℕ} {f : List.Vector ℕ n → ℕ} {ins : Fin n → ℕ}
    {out b : ℕ} (h : ∀ σ : ℕ → ℕ, (∀ x, b ≤ x → σ x = 0) →
      Exec s σ (update σ out (f (List.Vector.ofFn fun i => σ (ins i))))) :
    Realizes s (f : List.Vector ℕ n →. ℕ) ins out b := by
  intro σ σ' hσ
  rw [exec_iff_eq_of_exec (h σ hσ)]
  simp

/-- The constant zero function of no arguments is realizable. -/
theorem realizable_zero : Realizable ((fun _ => 0 : List.Vector ℕ 0 → ℕ) : List.Vector ℕ 0 →. ℕ) :=
  fun _ out _ _ _ _ => ⟨clear out, realizes_of_exec fun _ _ => exec_clear_iff.2 rfl⟩

/-- The successor function is realizable. -/
theorem realizable_succ :
    Realizable ((fun v => Nat.succ v.head : List.Vector ℕ 1 → ℕ) : List.Vector ℕ 1 →. ℕ) := by
  intro ins out b hins hout hne
  refine ⟨seq (assign (ins 0) out b) (inc out), realizes_of_exec fun σ hσ => ?_⟩
  have h₁ : ins 0 ≠ b := (hins 0).ne
  rw [exec_seq_iff_of_exec ((exec_assign_iff (hne 0) h₁ hout.ne (hσ b le_rfl)).2 rfl),
    exec_inc_iff]
  funext x
  simp only [List.Vector.head_ofFn]
  grind [update_apply]

/-- The projections are realizable. -/
theorem realizable_get {n : ℕ} (i : Fin n) :
    Realizable ((fun v => v.get i : List.Vector ℕ n → ℕ) : List.Vector ℕ n →. ℕ) := by
  intro ins out b hins hout hne
  refine ⟨assign (ins i) out b, realizes_of_exec fun σ hσ => ?_⟩
  rw [exec_assign_iff (hne i) (hins i).ne hout.ne (hσ b le_rfl), List.Vector.get_ofFn]

/-- `Realizes` is not vacuous: `skip` does not realize the successor function. -/
theorem not_realizes_skip_succ :
    ¬Realizes skip ((fun v => Nat.succ v.head : List.Vector ℕ 1 → ℕ) : List.Vector ℕ 1 →. ℕ)
      (fun _ => 0) 1 2 := by
  intro h
  have h₁ := (h.exec_iff (σ := fun _ => 0) (σ' := fun _ => 0) (fun _ _ => rfl)).1 (.skip _)
  have h₂ := congrFun h₁ 1
  simp at h₂

/-- Membership in a vector of partial values assembled by `List.Vector.mOfFn`. -/
theorem mem_mOfFn {n : ℕ} {g : Fin n → Part ℕ} {w : List.Vector ℕ n} :
    w ∈ List.Vector.mOfFn g ↔ ∀ i, w.get i ∈ g i := by
  induction n with
  | zero =>
    simp only [List.Vector.mOfFn, IsEmpty.forall_iff, iff_true]
    rw [List.Vector.eq_nil w]
    exact Part.mem_some _
  | succ n ih =>
    simp only [List.Vector.mOfFn, Part.bind_eq_bind, Part.mem_bind_iff, ih]
    constructor
    · rintro ⟨a, ha, v, hv, hw⟩
      obtain rfl : w = a ::ᵥ v := Part.mem_some_iff.1 hw
      intro i
      refine Fin.cases ?_ (fun j => ?_) i
      · simpa using ha
      · simpa using hv j
    · intro h
      refine ⟨w.head, by simpa using h 0, w.tail, fun j => ?_, ?_⟩
      · simpa using h j.succ
      · simp [pure]

/-- Evaluating the first `j` of the functions `g i` into the registers `t, …, t + j - 1`. -/
theorem exists_stmt_prefix {m n : ℕ} (g : Fin n → List.Vector ℕ m →. ℕ)
    (hg : ∀ i, Realizable (g i)) (ins : Fin m → ℕ) (t b : ℕ) (hins : ∀ i, ins i < t)
    (htb : t + n ≤ b) (j : ℕ) (hj : j ≤ n) :
    ∃ s : Stmt, ∀ σ σ' : ℕ → ℕ, (∀ x, b ≤ x → σ x = 0) →
      (Exec s σ σ' ↔ ∃ a : ℕ → ℕ,
        (∀ i : Fin n, (i : ℕ) < j → a i ∈ g i (List.Vector.ofFn fun k => σ (ins k))) ∧
        σ' = fun x => if t ≤ x ∧ x < t + j then a (x - t) else σ x) := by
  induction j with
  | zero =>
    refine ⟨skip, fun σ σ' _ => ?_⟩
    rw [exec_skip_iff]
    constructor
    · rintro rfl
      refine ⟨fun _ => 0, fun i hi => absurd hi (Nat.not_lt_zero _), ?_⟩
      funext x
      grind
    · rintro ⟨a, -, rfl⟩
      funext x
      grind
  | succ j ih =>
    obtain ⟨s, hs⟩ := ih (by omega)
    obtain ⟨sj, hsj⟩ := hg ⟨j, hj⟩ ins (t + j) b (fun i => by have := hins i; omega) (by omega)
      (fun i => by have := hins i; omega)
    refine ⟨seq s sj, fun σ σ' hσ => ?_⟩
    have hin : ∀ τ : ℕ → ℕ, (∀ k, τ (ins k) = σ (ins k)) →
        (List.Vector.ofFn fun k => τ (ins k)) = List.Vector.ofFn fun k => σ (ins k) :=
      fun τ h => congrArg _ (funext h)
    have hpre : ∀ (a : ℕ → ℕ) (τ : ℕ → ℕ),
        (τ = fun x => if t ≤ x ∧ x < t + j then a (x - t) else σ x) →
        (∀ x, b ≤ x → τ x = 0) ∧ ∀ k, τ (ins k) = σ (ins k) := by
      rintro a τ rfl
      refine ⟨fun x hx => ?_, fun k => ?_⟩
      · have := hσ x hx
        grind
      · have := hins k
        grind
    rw [exec_seq_iff]
    constructor
    · rintro ⟨τ, h₁, h₂⟩
      obtain ⟨a, ha, hτ⟩ := (hs σ τ hσ).1 h₁
      obtain ⟨hτ0, hτin⟩ := hpre a τ hτ
      obtain ⟨v, hv, rfl⟩ := (hsj τ σ' hτ0).1 h₂
      rw [hin τ hτin] at hv
      refine ⟨update a j v, fun i hi => ?_, ?_⟩
      · rcases Nat.lt_succ_iff_lt_or_eq.1 hi with h | h
        · have hne : (i : ℕ) ≠ j := by omega
          simpa [hne] using ha i h
        · obtain rfl : i = ⟨j, hj⟩ := Fin.ext h
          simpa using hv
      · subst hτ
        funext x
        grind [update_apply]
    · rintro ⟨a, ha, rfl⟩
      obtain ⟨τ, hτ⟩ : ∃ τ : ℕ → ℕ, τ = fun x => if t ≤ x ∧ x < t + j then a (x - t) else σ x :=
        ⟨_, rfl⟩
      obtain ⟨hτ0, hτin⟩ := hpre a τ hτ
      refine ⟨τ, (hs σ τ hσ).2 ⟨a, fun i hi => ha i (by omega), hτ⟩,
        (hsj τ _ hτ0).2 ⟨a j, ?_, ?_⟩⟩
      · rw [hin τ hτin]
        exact ha ⟨j, hj⟩ (by simp)
      · subst hτ
        funext x
        grind [update_apply]

/-- **Composition.** If `f` and all the `g i` are realizable, so is `v ↦ f (g 0 v, …, g (n-1) v)`
(undefined when some `g i v` is). -/
theorem realizable_comp {m n : ℕ} {f : List.Vector ℕ n →. ℕ} (g : Fin n → List.Vector ℕ m →. ℕ)
    (hf : Realizable f) (hg : ∀ i, Realizable (g i)) :
    Realizable fun v => (List.Vector.mOfFn fun i => g i v) >>= f := by
  intro ins out b hins hout hne
  obtain ⟨s₁, h₁⟩ := exists_stmt_prefix g hg ins b (b + n) hins le_rfl n le_rfl
  obtain ⟨s₂, h₂⟩ := hf (fun i => b + i) out (b + n) (fun i => by omega) (by omega)
    (fun i => by omega)
  refine ⟨seq s₁ (seq s₂ (clearRange b n)), fun σ σ' hσ => ?_⟩
  have hσ' : ∀ x, b + n ≤ x → σ x = 0 := fun x hx => hσ x (by omega)
  have hpre : ∀ (a : ℕ → ℕ) (τ : ℕ → ℕ),
      (τ = fun x => if b ≤ x ∧ x < b + n then a (x - b) else σ x) →
      (∀ x, b + n ≤ x → τ x = 0) ∧
        (List.Vector.ofFn fun i : Fin n => τ (b + i)) = List.Vector.ofFn fun i : Fin n => a i := by
    rintro a τ rfl
    refine ⟨fun x hx => ?_, congrArg _ (funext fun i => ?_)⟩
    · have := hσ' x hx
      grind
    · have := i.isLt
      grind
  have hbind : ∀ (o : Part (List.Vector ℕ n)) (v : ℕ), v ∈ o >>= f ↔ ∃ w ∈ o, v ∈ f w :=
    fun _ _ => Part.mem_bind_iff
  simp only [exec_seq_iff, exec_clearRange_iff, hbind]
  constructor
  · rintro ⟨τ₁, e₁, τ₂, e₂, rfl⟩
    obtain ⟨a, ha, hτ₁⟩ := (h₁ σ τ₁ hσ').1 e₁
    obtain ⟨hz₁, hw⟩ := hpre a τ₁ hτ₁
    obtain ⟨v, hv, rfl⟩ := (h₂ τ₁ τ₂ hz₁).1 e₂
    rw [hw] at hv
    refine ⟨v, ⟨_, mem_mOfFn.2 fun i => ?_, hv⟩, ?_⟩
    · rw [List.Vector.get_ofFn]
      exact ha i i.isLt
    · subst hτ₁
      funext x
      have := hσ x
      grind [update_apply]
  · rintro ⟨v, ⟨w, hw, hv⟩, rfl⟩
    rw [mem_mOfFn] at hw
    obtain ⟨a, ha⟩ : ∃ a : ℕ → ℕ, ∀ i : Fin n, a i = w.get i :=
      ⟨fun i => if h : i < n then w.get ⟨i, h⟩ else 0, fun i => by simp⟩
    obtain ⟨τ₁, hτ₁⟩ : ∃ τ₁ : ℕ → ℕ,
      τ₁ = fun x => if b ≤ x ∧ x < b + n then a (x - b) else σ x := ⟨_, rfl⟩
    obtain ⟨hz₁, hw'⟩ := hpre a τ₁ hτ₁
    have hw'' : (List.Vector.ofFn fun i : Fin n => a i) = w := by
      simp only [ha]
      exact List.Vector.ofFn_get w
    refine ⟨τ₁, (h₁ σ τ₁ hσ').2 ⟨a, fun i _ => by rw [ha i]; exact hw i, hτ₁⟩, update τ₁ out v,
      (h₂ τ₁ _ hz₁).2 ⟨v, by rw [hw', hw'']; exact hv, rfl⟩, ?_⟩
    subst hτ₁
    funext x
    have := hσ x
    grind [update_apply]

/-- Reading the registers listed by `Fin.cons a h`. -/
theorem ofFn_comp_cons {n : ℕ} (ρ : ℕ → ℕ) (a : ℕ) (h : Fin n → ℕ) :
    (List.Vector.ofFn fun i => ρ (Fin.cons (α := fun _ => ℕ) a h i)) =
      ρ a ::ᵥ List.Vector.ofFn fun i => ρ (h i) := by
  simp [List.Vector.ofFn]

/-- **Primitive recursion.** If the total functions `f` and `g` are realizable, so is the function
defined from them by primitive recursion on the first argument. -/
theorem realizable_prec {n : ℕ} {f : List.Vector ℕ n → ℕ} {g : List.Vector ℕ (n + 2) → ℕ}
    (hf : Realizable (f : List.Vector ℕ n →. ℕ))
    (hg : Realizable (g : List.Vector ℕ (n + 2) →. ℕ)) :
    Realizable ((fun v : List.Vector ℕ (n + 1) =>
      v.head.rec (f v.tail) fun y IH => g (y ::ᵥ IH ::ᵥ v.tail) : List.Vector ℕ (n + 1) → ℕ) :
      List.Vector ℕ (n + 1) →. ℕ) := by
  intro ins out b hins hout hne
  have hins' : ∀ i : Fin n, ins i.succ < b := fun i => hins i.succ
  obtain ⟨sf, hsf⟩ := hf (fun i => ins i.succ) (b + 1) (b + 4)
    (fun i => by have := hins' i; omega) (by omega) (fun i => by have := hins' i; omega)
  obtain ⟨sg, hsg⟩ := hg (Fin.cons b (Fin.cons (b + 1) fun i => ins i.succ)) (b + 2) (b + 4)
    (by
      simp only [Fin.forall_fin_succ, Fin.cons_zero, Fin.cons_succ]
      exact ⟨by omega, by omega, fun i => by have := hins' i; omega⟩)
    (by omega)
    (by
      simp only [Fin.forall_fin_succ, Fin.cons_zero, Fin.cons_succ]
      exact ⟨by omega, by omega, fun i => by have := hins' i; omega⟩)
  refine ⟨seq sf (seq (copy (ins 0) (b + 3) (b + 4)) (seq
    (loop (b + 3) (seq sg (seq (clear (b + 1)) (seq (move (b + 2) (b + 1)) (inc b)))))
    (seq (clear out) (seq (move (b + 1) out) (clear b))))), realizes_of_exec fun σ hσ => ?_⟩
  simp only [List.Vector.head_ofFn, List.Vector.tail_ofFn]
  have hi0 : ins 0 < b := hins 0
  have hne0 : ins 0 ≠ out := hne 0
  obtain ⟨V, hV⟩ : ∃ V, V = List.Vector.ofFn fun i : Fin n => σ (ins i.succ) := ⟨_, rfl⟩
  obtain ⟨R, hR⟩ : ∃ R : ℕ → ℕ, R = fun k => Nat.rec (f V) (fun y IH => g (y ::ᵥ IH ::ᵥ V)) k :=
    ⟨_, rfl⟩
  have hR0 : R 0 = f V := by
    subst hR
    rfl
  have hRs : ∀ k, R (k + 1) = g (k ::ᵥ R k ::ᵥ V) := fun k => by
    subst hR
    rfl
  rw [← hV]
  change Exec _ σ (update σ out ((fun k => Nat.rec (f V) (fun y IH => g (y ::ᵥ IH ::ᵥ V)) k)
    (σ (ins 0))))
  rw [← hR]
  clear hR
  -- first the base value, then the counter
  obtain ⟨σ₁, hσ₁⟩ : ∃ σ₁ : ℕ → ℕ, σ₁ = update σ (b + 1) (f V) := ⟨_, rfl⟩
  have e₁ : Exec sf σ σ₁ := by
    rw [hsf.exec_iff (fun x hx => hσ x (by omega)), hσ₁, hV]
  obtain ⟨σ₂, hσ₂⟩ : ∃ σ₂ : ℕ → ℕ, σ₂ = update σ₁ (b + 3) (σ (ins 0)) := ⟨_, rfl⟩
  have e₂ : Exec (copy (ins 0) (b + 3) (b + 4)) σ₁ σ₂ := by
    have h4 : σ₁ (b + 4) = 0 := by
      have := hσ (b + 4) (by omega)
      subst hσ₁
      grind [update_apply]
    rw [exec_copy_iff (by omega) (by omega) (by omega) h4]
    have := hσ (b + 3) (by omega)
    subst hσ₂ hσ₁
    grind [update_apply]
  -- the loop
  obtain ⟨S, hS⟩ : ∃ S : ℕ → ℕ → ℕ, S = fun k x =>
      if x = b then k else if x = b + 1 then R k else if x = b + 3 then σ (ins 0) - k else σ x :=
    ⟨_, rfl⟩
  have h23 : σ₂ (b + 3) = σ (ins 0) := by simp [hσ₂]
  have hS0 : S 0 = σ₂ := by
    subst hS hσ₂ hσ₁
    funext x
    have := hσ x
    grind [update_apply]
  have hSr : ∀ k, S k (b + 3) = σ₂ (b + 3) - k := by
    intro k
    rw [h23, hS]
    grind
  have hbody : ∀ k, k < σ₂ (b + 3) → ∀ τ,
      Exec (seq sg (seq (clear (b + 1)) (seq (move (b + 2) (b + 1)) (inc b))))
        (update (S k) (b + 3) (σ₂ (b + 3) - k - 1)) τ ↔ τ = S (k + 1) := by
    intro k hk τ
    obtain ⟨ρ, hρ⟩ : ∃ ρ : ℕ → ℕ, ρ = update (S k) (b + 3) (σ₂ (b + 3) - k - 1) := ⟨_, rfl⟩
    rw [← hρ]
    have hρ0 : ∀ x, b + 4 ≤ x → ρ x = 0 := by
      intro x hx
      have := hσ x (by omega)
      subst hρ hS
      grind [update_apply]
    have hargs : (List.Vector.ofFn fun i => ρ ((Fin.cons b (Fin.cons (b + 1) fun i => ins i.succ) :
        Fin (n + 2) → ℕ) i)) = k ::ᵥ R k ::ᵥ V := by
      rw [ofFn_comp_cons, ofFn_comp_cons, hV]
      have hb₀ : ρ b = k := by
        subst hρ hS
        grind [update_apply]
      have hb₁ : ρ (b + 1) = R k := by
        subst hρ hS
        grind [update_apply]
      have hb₂ : ∀ i : Fin n, ρ (ins i.succ) = σ (ins i.succ) := by
        intro i
        have := hins' i
        subst hρ hS
        grind [update_apply]
      simp only [hb₀, hb₁, hb₂]
    have e : Exec sg ρ (update ρ (b + 2) (g (k ::ᵥ R k ::ᵥ V))) := by
      rw [hsg.exec_iff hρ0, hargs]
    rw [exec_seq_iff_of_exec e, exec_seq_iff_of_exec (exec_clear_iff.2 rfl),
      exec_seq_iff_of_exec ((exec_move_iff (by omega)).2 rfl), exec_inc_iff]
    refine iff_of_eq (congrArg _ ?_)
    have := hRs k
    have h2 := hσ (b + 2) (by omega)
    subst hρ hS
    funext x
    grind [update_apply]
  have e₃ := (exec_loop_iff_of_count S hS0 hSr hbody _).2 rfl
  rw [exec_seq_iff_of_exec e₁, exec_seq_iff_of_exec e₂, exec_seq_iff_of_exec e₃,
    exec_seq_iff_of_exec (exec_clear_iff.2 rfl),
    exec_seq_iff_of_exec ((exec_move_iff (by omega)).2 rfl), exec_clear_iff, h23]
  subst hS
  funext x
  have := hσ x
  grind [update_apply]

/-- **Minimization.** If the total function `f` is realizable, so is the partial function sending
`v` to the least `k` with `f (k, v) = 0`. -/
theorem realizable_rfind {n : ℕ} {f : List.Vector ℕ (n + 1) → ℕ}
    (hf : Realizable (f : List.Vector ℕ (n + 1) →. ℕ)) :
    Realizable fun v : List.Vector ℕ n =>
      Nat.rfind fun k => Part.some (f (k ::ᵥ v) = 0) := by
  intro ins out b hins hout hne
  obtain ⟨sf, hsf⟩ := hf (Fin.cons out ins) b (b + 1)
    (by
      simp only [Fin.forall_fin_succ, Fin.cons_zero, Fin.cons_succ]
      exact ⟨by omega, fun i => by have := hins i; omega⟩)
    (by omega)
    (by
      simp only [Fin.forall_fin_succ, Fin.cons_zero, Fin.cons_succ]
      exact ⟨by omega, fun i => by have := hins i; omega⟩)
  refine ⟨seq (clear out) (seq sf (loop b (seq (inc out) sf))), fun σ σ' hσ => ?_⟩
  obtain ⟨V, hV⟩ : ∃ V, V = List.Vector.ofFn fun i : Fin n => σ (ins i) := ⟨_, rfl⟩
  rw [← hV]
  have hb0 : σ b = 0 := hσ b le_rfl
  -- one evaluation of `f` at the current candidate
  have key : ∀ (ρ : ℕ → ℕ) (k : ℕ), (∀ x, b + 1 ≤ x → ρ x = 0) → ρ out = k →
      (∀ i, ρ (ins i) = σ (ins i)) → Exec sf ρ (update ρ b (f (k ::ᵥ V))) := by
    intro ρ k hρ0 hk hρin
    rw [hsf.exec_iff hρ0, ofFn_comp_cons, hk, hV]
    simp only [hρin]
  obtain ⟨S, hS⟩ : ∃ S : ℕ → ℕ → ℕ, S = fun k => update (update σ out k) b (f (k ::ᵥ V)) :=
    ⟨_, rfl⟩
  have hSb : ∀ k, S k b = f (k ::ᵥ V) := fun k => by simp [hS]
  have hSk : ∀ k, f (k ::ᵥ V) = 0 → S k = update σ out k := by
    intro k hk
    subst hS
    funext x
    grind [update_apply]
  have e₁ : Exec (clear out) σ (update σ out 0) := exec_clear_iff.2 rfl
  have e₂ : Exec sf (update σ out 0) (S 0) := by
    rw [hS]
    refine key _ 0 (fun x hx => ?_) (by simp) (fun i => ?_)
    · have := hσ x (by omega)
      grind [update_apply]
    · have := hne i
      grind [update_apply]
  have hbody : ∀ k, S k b ≠ 0 → ∀ τ,
      Exec (seq (inc out) sf) (update (S k) b (S k b - 1)) τ ↔ τ = S (k + 1) := by
    intro k _ τ
    obtain ⟨ρ, hρ⟩ : ∃ ρ : ℕ → ℕ, ρ = update (update (S k) b (S k b - 1)) out
      (update (S k) b (S k b - 1) out + 1) := ⟨_, rfl⟩
    have e : Exec sf ρ (update ρ b (f ((k + 1) ::ᵥ V))) := by
      refine key ρ (k + 1) (fun x hx => ?_) ?_ (fun i => ?_)
      · have := hσ x (by omega)
        subst hρ hS
        grind [update_apply]
      · subst hρ hS
        grind [update_apply]
      · have := hne i
        have := hins i
        subst hρ hS
        grind [update_apply]
    rw [exec_seq_iff_of_exec (exec_inc_iff.2 hρ), exec_iff_eq_of_exec e]
    refine iff_of_eq (congrArg _ ?_)
    subst hρ hS
    funext x
    grind [update_apply]
  rw [exec_seq_iff_of_exec e₁, exec_seq_iff_of_exec e₂, exec_loop_iff_of_seq S hbody]
  simp only [hSb]
  constructor
  · rintro ⟨k, hk0, hmin, rfl⟩
    refine ⟨k, Nat.mem_rfind.2 ⟨?_, fun {j} hj => ?_⟩, hSk k hk0⟩
    · simp [hk0]
    · simp [hmin j hj]
  · rintro ⟨k, hk, rfl⟩
    replace hk := Nat.mem_rfind.1 hk
    have hk0 : f (k ::ᵥ V) = 0 := by simpa using hk.1
    refine ⟨k, hk0, fun j hj => ?_, (hSk k hk0).symm⟩
    simpa using hk.2 hj

/-! ### Every partial recursive function is realizable -/

/-- Every primitive recursive function of several arguments (in Mathlib's vector basis
`Nat.Primrec'`) is realizable. -/
theorem realizable_of_primrec' {n : ℕ} {f : List.Vector ℕ n → ℕ} (hf : Nat.Primrec' f) :
    Realizable (f : List.Vector ℕ n →. ℕ) := by
  induction hf with
  | zero => exact realizable_zero
  | succ => exact realizable_succ
  | get i => exact realizable_get i
  | @comp m n f g _ _ ihf ihg =>
    have h := realizable_comp (fun i => (g i : List.Vector ℕ m →. ℕ)) ihf ihg
    have e : (fun v => (List.Vector.mOfFn fun i => (g i : List.Vector ℕ m →. ℕ) v) >>=
        (f : List.Vector ℕ n →. ℕ)) =
        ((fun a => f (List.Vector.ofFn fun i => g i a) : List.Vector ℕ m → ℕ) :
          List.Vector ℕ m →. ℕ) := by
      funext v
      simp only [PFun.coe_val, Vector.mOfFn_part_some]
      exact Part.bind_some _ _
    rwa [e] at h
  | prec _ _ ihf ihg => exact realizable_prec ihf ihg

/-- Every partial recursive function of several arguments (in Mathlib's vector basis
`Nat.Partrec'`) is realizable. -/
theorem realizable_of_partrec' {n : ℕ} {f : List.Vector ℕ n →. ℕ} (hf : Nat.Partrec' f) :
    Realizable f := by
  induction hf with
  | prim h => exact realizable_of_primrec' h
  | comp g _ _ ihf ihg => exact realizable_comp g ihf ihg
  | rfind _ ih => exact realizable_rfind ih

/-- **Every partial recursive function is computed by a statement of the loop language**, with
the cleanest possible interface: started on the initial registers for the input `n` (input in
register `0`, everything else zero), the statement terminates iff `f n` is defined, and then the
final registers are the initial registers for `f n` (value in register `0`, everything else
zero). -/
theorem exists_stmt_of_partrec {f : ℕ →. ℕ} (hf : Nat.Partrec f) :
    ∃ s : Stmt, ∀ (n : ℕ) (σ' : ℕ → ℕ),
      Exec s (Cfg.init n).regs σ' ↔ ∃ v ∈ f n, σ' = (Cfg.init v).regs := by
  have h₁ : Nat.Partrec' fun v : List.Vector ℕ 1 => f v.head :=
    Nat.Partrec'.part_iff₁.2 (Partrec.nat_iff.2 hf)
  obtain ⟨s, hs⟩ := realizable_of_partrec' h₁ (fun _ => 0) 1 2 (fun _ => by omega) (by omega)
    (fun _ => by omega)
  refine ⟨seq s (seq (clear 0) (move 1 0)), fun n σ' => ?_⟩
  have h0 : ∀ x, 2 ≤ x → (Cfg.init n).regs x = 0 := by
    intro x hx
    have : x ≠ 0 := by omega
    simp [Cfg.init, this]
  have hfin : ∀ v, update (update (update (update (Cfg.init n).regs 1 v) 0 0) 0
      (update (update (Cfg.init n).regs 1 v) 0 0 0 + update (update (Cfg.init n).regs 1 v) 0 0 1))
      1 0 = (Cfg.init v).regs := by
    intro v
    funext x
    simp only [Cfg.init]
    grind [update_apply]
  simp only [exec_seq_iff, exec_clear_iff, exec_move_iff (show (1 : ℕ) ≠ 0 by omega),
    exists_eq_left]
  constructor
  · rintro ⟨τ, hτ, rfl⟩
    obtain ⟨v, hv, rfl⟩ := (hs _ τ h0).1 hτ
    exact ⟨v, by simpa [Cfg.init] using hv, hfin v⟩
  · rintro ⟨v, hv, rfl⟩
    exact ⟨_, (hs _ _ h0).2 ⟨v, by simpa [Cfg.init] using hv, rfl⟩, (hfin v).symm⟩

/-- **Universality of counter machines, strong form.** For every partial recursive `f : ℕ →. ℕ`
there is a well-formed counter program which, started on the initial configuration for the input
`n`, halts iff `f n` is defined, and then halts at its last instruction (a `halt`) with `f n` in
register `0` and zero in every other register. -/
theorem exists_program_eval_eq_of_partrec {f : ℕ →. ℕ} (hf : Nat.Partrec f) :
    ∃ P : Program, P.WellFormed ∧ ∀ n,
      P.eval (Cfg.init n) = (f n).map fun v => ⟨P.length - 1, (Cfg.init v).regs⟩ := by
  obtain ⟨s, hs⟩ := exists_stmt_of_partrec hf
  exact ⟨s.compile, s.wellFormed_compile, fun n =>
    eval_compile_eq_map (σ := (Cfg.init n).regs) (init_regs_zeroReg s n) (f n) _ (hs n)⟩

/-- **Universality of counter machines.** Every partial recursive function `f : ℕ →. ℕ` is
computed by a well-formed counter program, with instructions `inc`, `decJz` and `halt` only. -/
theorem exists_computes_of_partrec {f : ℕ →. ℕ} (hf : Nat.Partrec f) :
    ∃ P : Program, P.WellFormed ∧ P.Computes f := by
  obtain ⟨P, hP, h⟩ := exists_program_eval_eq_of_partrec hf
  refine ⟨P, hP, fun n => ?_⟩
  rw [h n, Part.map_map]
  exact Part.map_id' (fun v => by simp [Cfg.init]) _

/-- **Universality of counter machines, for codes.** For every code `c` of a partial recursive
function there is a well-formed counter program computing `c.eval`: for every input `n`, the
content of register `0` when the program halts from `Cfg.init n` is `c.eval n`, as partial
values. -/
theorem exists_computes_code (c : Nat.Partrec.Code) :
    ∃ P : Program, P.WellFormed ∧ P.Computes c.eval :=
  exists_computes_of_partrec (Nat.Partrec.Code.exists_code.2 ⟨c, rfl⟩)

/-- The halting behaviour of the programs of `exists_computes_code`: a program computing `c.eval`
halts from the initial configuration for `n` exactly when `c.eval n` is defined. -/
theorem Program.Computes.halts_iff {P : Program} {f : ℕ →. ℕ} (h : P.Computes f) (n : ℕ) :
    P.Halts (Cfg.init n) ↔ (f n).Dom := by
  rw [← h n]
  rfl

/-- **An undecidable halting problem for one counter program.** There is a well-formed counter
program `P` such that no algorithm determines, given `n`, whether `P` halts on the input `n`. -/
theorem exists_program_halts_not_computable :
    ∃ P : Program, P.WellFormed ∧ ¬ComputablePred fun n : ℕ => P.Halts (Cfg.init n) := by
  have hpart : Nat.Partrec fun m =>
      Nat.Partrec.Code.eval (Denumerable.ofNat Nat.Partrec.Code m) 0 :=
    Partrec.nat_iff.1
      (Nat.Partrec.Code.eval_part.comp (Computable.ofNat Nat.Partrec.Code) (Computable.const 0))
  obtain ⟨P, hP, hc⟩ := exists_computes_of_partrec hpart
  refine ⟨P, hP, fun h => ComputablePred.halting_problem 0 ?_⟩
  obtain ⟨f, hf, hfe⟩ := ComputablePred.computable_iff.1 h
  refine ComputablePred.computable_iff.2
    ⟨fun c => f (Encodable.encode c), hf.comp Computable.encode, ?_⟩
  funext c
  rw [← congrFun hfe (Encodable.encode c)]
  exact propext (by rw [hc.halts_iff, Denumerable.ofNat_encode])

end LeanTheory.Computability
