/-- Far from every component of a list: all components at once. -/
macro "dsepT_fa" : tactic => `(tactic| (
  repeat' apply And.intro
  all_goals first
    | exact BU.farApart_box (by omega)
    | exact regLanes_farApart_box (by omega)
    | trivial))

/-- A set placed at module `r` from a list of sets each far from a box. -/
theorem dsepT_modImg_unionL {r : ℕ} {B : Set Cell} :
    ∀ {Ls : List (Set Cell)}, (∀ S ∈ Ls, FarApart 2 (modImg p r S) B) →
      FarApart 2 (modImg p r (unionL Ls)) B
  | [], _ => by
    rintro _ ⟨x, hx, rfl⟩
    exact hx.elim
  | S :: Ls, h => by
    rintro _ ⟨x, hx, rfl⟩
    rcases hx with hx | hx
    · exact h S List.mem_cons_self _ ⟨x, hx, rfl⟩
    · exact dsepT_modImg_unionL (fun S' hS' => h S' (List.mem_cons_of_mem _ hS')) _ ⟨x, hx, rfl⟩

/-- The groups of the circuit are their own pieces. -/
theorem dsepT_grp_own (r i : ℕ) (hi : i < 28) {L : List Piece} (hL : ∀ x ∈ modGroup p r, x ∈ L) :
    ∃ x ∈ L, dsepTB x = (dsepTBase (.dz2g i)).mv (modDX p r) (modDY p r) :=
  ⟨_, hL _ (List.mem_map.2 ⟨_, List.mem_map.2 ⟨Base.dz2g i, List.mem_map.2
    ⟨i, List.mem_range.2 hi, rfl⟩, rfl⟩, rfl⟩), rfl⟩

