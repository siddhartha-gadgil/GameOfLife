/-! ### The reflector -/

/-- A period-30 reflector: the queen bee shuttle of the Gosper gun, stabilised by its block on
the left and by an eater on the right. 27 cells. -/
def reflector : Finset Cell :=
  ofRows 0 2 [12288, 34816, 66563, 214019, 66560, 1607680, 2633728, 2097152, 6291456]

/-- The reflector is an oscillator of period exactly 30. -/
theorem reflector_isOscillator : IsOscillator reflector 30 := by
  refine ⟨by norm_num, by life_cert, fun k hk0 hk => ?_⟩
  interval_cases k <;> (life_eval; exact ofRows_ne rfl rfl (by simp))

/-- The reflector with the incoming glider `ofRows 20 0 [1, 5, 3]`, as one window. -/
theorem reflector_union_in :
    reflector ∪ ofRows 20 0 [1, 5, 3] =
      ofRows 0 0 [1048576, 5242880, 3158016, 34816, 66563, 214019, 66560, 1607680, 2633728,
        2097152, 6291456] := by
  rw [reflector, ofRows_eq_padRows 0 2 2 0 _ rfl rfl, ofRows_eq_padRows 20 0 0 20 _ rfl rfl,
    ← ofRows_orRows]
  rfl

/-- The reflector with the outgoing glider `ofRows 11 (-4) [2, 3, 5]`, as one window. -/
theorem reflector_union_out :
    reflector ∪ ofRows 11 (-4) [2, 3, 5] =
      ofRows 0 (-4) [4096, 6144, 10240, 0, 0, 0, 12288, 34816, 66563, 214019, 66560, 1607680,
        2633728, 2097152, 6291456] := by
  rw [reflector, ofRows_eq_padRows' 0 (-4) 0 2 6 0 _ (by norm_num) (by norm_num),
    ofRows_eq_padRows' 0 (-4) 11 (-4) 0 11 _ (by norm_num) (by norm_num), ← ofRows_orRows]
  rfl

/-- **Reflection**: a glider travelling down and to the left that meets the reflector on the
right lane at the right time leaves, 30 generations later, travelling up and to the left; the
reflector is unchanged. -/
theorem reflector_reflects :
    conway.evolve 30 (reflector ∪ ofRows 20 0 [1, 5, 3]) =
      reflector ∪ ofRows 11 (-4) [2, 3, 5] := by
  rw [reflector_union_in, reflector_union_out]
  life_cert

