set_option maxRecDepth 100000 in
/-- **An answer passes the station Z** in 288 generations, to the place of the next station's. -/
theorem stZ_relay :
    Reaction (stZG ∪ stZX) (phase stZG 288 ∪ translate (72, -72) stZX) 288 (fun _ => stZR) := by
  have hf := flight_reaction stZX_four stZX_box 72 0 (G' := translate (72, -72) stZX) (by
    rw [Rule.evolve_zero]; norm_num)
  have hg := phase_reaction stZG_rest 0 288
  rw [phase, Nat.zero_mod, Rule.evolve_zero, zero_add] at hg
  have h := hg.par hf fun i hi => by
    refine FarApart.union_left (FarApart.union_left ?_ ?_) ?_ <;>
      exact Box.farApart (by omega)
  refine h.mono fun i hi c hc => ?_
  rcases hc with hc | hc
  · exact Or.inl hc
  · right
    exact ⟨((i / 4 : ℕ) : ℤ), by positivity, by omega, hc⟩

set_option maxRecDepth 100000 in
/-- **A chain of stations on the line Z**, any length: an answer passes `L + 1` stations placed
every `(72, -72)` in `(L + 1) 288` generations. -/
theorem stZChain (L : ℕ) :
    Reaction (relayChain stZG 288 (72, -72) (L + 1) 0 ∪ stZX)
      (relayChain stZG 288 (72, -72) (L + 1) ((L + 1) * 288) ∪
        translate (((L + 1 : ℕ) : ℤ) * (72, -72).1, ((L + 1 : ℕ) : ℤ) * (72, -72).2) stZX)
      ((L + 1) * 288) (fun _ => chainFoot stZR (72, -72) (L + 1)) := by
  refine chain_reaction_set stZG_rest stZ_relay (fun c hc => Or.inl hc) ?_ ?_ ?_ L
  · intro j hj x hx y hy hn
    simp only [Set.mem_union] at hx hy
    obtain ⟨n1, n2, n3, n4⟩ := hn
    rcases hx with ((⟨a1, a2, a3, a4⟩ | ⟨a1, a2, a3, a4⟩) | ⟨a1, a2, a3, a4⟩) <;>
      rcases hy with ((⟨b1, b2, b3, b4⟩ | ⟨b1, b2, b3, b4⟩) | ⟨b1, b2, b3, b4⟩) <;>
      (push_cast at *; omega)
  · intro j hj x hx y hy hn
    simp only [stZR, Set.mem_union] at hx hy
    obtain ⟨n1, n2, n3, n4⟩ := hn
    rcases hx with (((⟨a1, a2, a3, a4⟩ | ⟨a1, a2, a3, a4⟩) | ⟨a1, a2, a3, a4⟩) | ⟨m, ml, mu, a1, a2, a3, a4⟩) <;>
      rcases hy with ((⟨b1, b2, b3, b4⟩ | ⟨b1, b2, b3, b4⟩) | ⟨b1, b2, b3, b4⟩) <;>
      (push_cast at *; omega)
  · intro j hj x hx y hy hn
    simp only [stZR, Set.mem_union] at hx hy
    obtain ⟨n1, n2, n3, n4⟩ := hn
    rcases hx with ((⟨a1, a2, a3, a4⟩ | ⟨a1, a2, a3, a4⟩) | ⟨a1, a2, a3, a4⟩) <;>
      rcases hy with (((⟨b1, b2, b3, b4⟩ | ⟨b1, b2, b3, b4⟩) | ⟨b1, b2, b3, b4⟩) | ⟨m2, m2l, m2u, b1, b2, b3, b4⟩) <;>
