module

public import LeanTheory.Theory.Life.MergeChain

/-!
# The merge chain entered from the side at the residue 10

The side input of the OR gate at the R-29 residue 10 (window offset `8` of the side world line
`sideWL`; the control `C` of a `decJz` instruction with odd `q = D - 1 - j` arrives at its DEC copy
at offset `4 + 2 σ = 8`) releases the same glider as the through input, `134` generations later, so
a chain of OR gates carries it like a through input (`chain_side_reaction`).
Generated by `scripts/life_cert/act_side_dec.py` (untrusted); the certificates are checked here.
-/

set_option linter.style.longLine false

@[expose] public section

namespace LeanTheory.Life

open Finset

/-- The side input of the OR gate at residue 10 (R-29 numbering). -/
def orSide10 : Finset Cell := ofRows 43 33 [3, 6, 1]

/-- The OR gate after 134 generations. -/
theorem orGate_phase10 : phase orGate 134 = ofRows 0 0 [83886080, 92233720368832970752, 78398662365073637632, 4835707998230978276361152, 36267850789344570618447523, 1908931652715048442736807571, 1948199384398706554738509472, 52019910521581304108221376, 36297879674767169229422848, 4835703278458516698824704, 0, 0, 0, 335544320, 23058430092539592704, 13835058055416381440, 9223372036854775808, 0, 0, 0, 17179869184, 72057697117143040, 54043247068053504, 108086391056891904, 0, 0, 0, 0, 10995116277760, 716881581309952, 426610511577088, 281474976710656] := by
  rw [phase, show 134 % 30 = 14 by norm_num, orGate]
  life_cert

