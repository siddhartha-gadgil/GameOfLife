    conway.evolve (4 * k + 11490) (dz2gRest ∪ ofRows (-1186) (-1227) [2, 4, 7] ∪ reg1Block ↑k) =
      conway.evolve (4 * k) dz2gRest ∪ reg1Block (↑k - 1) ∪
        translate ((k : ℤ), (k : ℤ)) (ofRows 603 994 [1, 6, 3]) := by
  have hs : Proc.start (dz2gL0 k) = dz2gRest ∪ ofRows (-1186) (-1227) [2, 4, 7] ∪ reg1Block ↑k := by
    simp only [dz2gL0, dz2gRest, dz2gA0, dz2gG0, dz2gG1, dz2gG2, dz2gG3, dz2gG4, dz2gG5, dz2gG6, dz2gG7, dz2gG8, dz2gG9, dz2gG10, dz2gG11, dz2gG12, dz2gG13, dz2gG14, dz2gG15, dz2gG16, dz2gG17, dz2gG18, dz2gG19, dz2gG20, dz2gG21, dz2gG22, dz2gG23, dz2gG24, dz2gG25, dz2gG26, dz2gG27, Proc.start_cons, Proc.start_nil, Piece.bundle, Piece.idle,
