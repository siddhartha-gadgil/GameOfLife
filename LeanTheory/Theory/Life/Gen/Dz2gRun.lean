theorem dz2gPullEnd (k : ℕ) : conway.evolve (4 * k + 5295) (dz2gPullX k) = reg1Block (↑k - 1) := by
  rw [show 4 * k + 5295 = (k + 106) * 4 + 4871 by omega, dz2gPullX,
