/-- **The tight footprint of the OR gate** (gate frame): its box without the corner
`[60, 90] × [20, 32]`. -/
def orGateTight : Set Cell := Box 0 90 0 19 ∪ Box 0 59 0 32

/-- The rows of a window at the origin fit the tight footprint from row `i` on: at most `33` rows,
rows `< 20` of width `≤ 91`, rows `≥ 20` of width `≤ 60`. -/
def tightRowsOK : List ℕ → ℕ → Bool
  | [], _ => true
  | r :: rs, i => (i < 33 && if i < 20 then r < 2 ^ 91 else r < 2 ^ 60) && tightRowsOK rs (i + 1)

/-- A set bit of a number below `2 ^ k` is below `k`. -/
theorem tight_bit_lt {n j k : ℕ} (h : n < 2 ^ k) (hb : n.testBit j = true) : j < k := by
  by_contra hj
  rw [Nat.testBit_eq_false_of_lt (lt_of_lt_of_le h (Nat.pow_le_pow_right (by norm_num)
    (Nat.le_of_not_lt hj)))] at hb
  exact Bool.false_ne_true hb

/-- The checker gives the bounds of every row. -/
theorem tightRowsOK_get : ∀ (rows : List ℕ) (i0 : ℕ), tightRowsOK rows i0 = true →
    ∀ i < rows.length, i0 + i < 33 ∧ (i0 + i < 20 → rows.getD i 0 < 2 ^ 91) ∧
      (20 ≤ i0 + i → rows.getD i 0 < 2 ^ 60)
  | [], _, _, i, hi => absurd hi (by simp)
  | r :: rs, i0, h, i, hi => by
    simp only [tightRowsOK, Bool.and_eq_true, decide_eq_true_eq] at h
    obtain ⟨⟨h1, h2⟩, h3⟩ := h
    rcases i with _ | i
    · refine ⟨by omega, fun h => ?_, fun h => ?_⟩
      · simpa [show i0 < 20 by omega] using h2
      · simpa [show ¬ i0 < 20 by omega] using h2
    · have := tightRowsOK_get rs (i0 + 1) h3 i (by simpa using hi)
      simp only [List.getD_cons_succ]
      refine ⟨by omega, fun h => this.2.1 (by omega), fun h => this.2.2 (by omega)⟩

/-- **A window accepted by the checker lies in the tight footprint.** -/
theorem ofRows_tight {rows : List ℕ} (h : tightRowsOK rows 0 = true) :
    (ofRows 0 0 rows : Set Cell) ⊆ orGateTight := by
  intro c hc
  simp only [ofRows, coe_biUnion, coe_range, Set.mem_Iio, Set.mem_iUnion, coe_image, coe_filter,
    Set.mem_image, Set.mem_ofPred_eq] at hc
  obtain ⟨i, hi, j, ⟨-, hb⟩, rfl⟩ := hc
  obtain ⟨h1, h2, h3⟩ := tightRowsOK_get rows 0 h i hi
  simp only [zero_add] at h1 h2 h3
  by_cases hy : i < 20
  · have := tight_bit_lt (h2 hy) hb
    exact Or.inl ⟨by omega, by omega, by omega, by omega⟩
  · have := tight_bit_lt (h3 (by omega)) hb
    exact Or.inr ⟨by omega, by omega, by omega, by omega⟩

