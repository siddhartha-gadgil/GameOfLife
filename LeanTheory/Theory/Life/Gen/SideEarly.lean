    show orGate ∪ orSide7 = ofRows 0 0 [16777216, 73786976294859177984, 368934881525733797888, 455118177873004657149952, 644012837187738926121987, 1858139645101047596242387971, 1858223245745189647925969920, 1227889072522402593802240, 642241841670271749074944, 453347182355485948903424, 147573952589726744576, 110680464442282475520, 221360928884514619392, 0, 0, 0, 0, 5368709120, 1441151887201009664, 864691130602618880, 576460752303423488, 0, 0, 0, 274877906944, 4505248894812160, 3378524354248704, 6755399441055744, 0, 0, 0, 0, 52776558133248, 43980465111040, 35184372088832] by
