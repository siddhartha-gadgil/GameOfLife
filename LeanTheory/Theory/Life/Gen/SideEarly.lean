/-!
# Early side inputs of the OR gate: certificates

The glider arriving on the side line of an OR gate (`orSide6`, offset `4`; `orSide7`, offset `5`)
comes within distance `2` of the gate's box in the last `10`-`11` generations before the side-input
time, so its flight cannot be run beside the idle gate up to that time. Instead the gate and the
glider are run **together** from `16` generations before: the gate at phase `14` and the glider of
the side line `16` generations early (`orSide6E = sideBase.cells 160`, `orSide7E = sideBase.cells
159`) become exactly `orGate ∪ orSide6` resp. `orGate ∪ orSide7`, inside `Box 0 90 0 38`
(`orGate_side6E`, `orGate_side7E`). Before that window the glider box is `>= 4` rows above the box
of the gate. Generated by `scripts/life_cert/side_early.py` (untrusted); the certificates are
checked here.
-/

set_option linter.style.longLine false

@[expose] public section

namespace LeanTheory.Life

open Finset

namespace LP

/-- The OR gate at phase `14`. -/
theorem orGate_phase14 : phase orGate 14 = ofRows 0 0 [83886080, 92233720368832970752, 78398662365073637632, 4835707998230978276361152, 36267850789344570618447523, 1908931652715048442736807571, 1948199384398706554738509472, 52019910521581304108221376, 36297879674767169229422848, 4835703278458516698824704, 0, 0, 0, 335544320, 23058430092539592704, 13835058055416381440, 9223372036854775808, 0, 0, 0, 17179869184, 72057697117143040, 54043247068053504, 108086391056891904, 0, 0, 0, 0, 10995116277760, 716881581309952, 426610511577088, 281474976710656] := by
  rw [phase, show 14 % 30 = 14 by norm_num, orGate]
  life_cert

/-- The side input `orSide6`, `16` generations early. -/
def orSide6E : Finset Cell := ofRows 40 36 [3, 6, 1]

/-- The early side input `orSide6E` is the glider of the side line at time `160`. -/
theorem orSide6E_eq : orSide6E = sideBase.cells 160 := rfl

set_option maxRecDepth 100000 in
/-- **Certificate**: the OR gate at phase `14` and the side input `orSide6`, `16`
generations early, become the gate at phase `0` and `orSide6`, inside `Box 0 90 0 38`. -/
