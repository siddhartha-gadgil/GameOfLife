  rw [show phase orGate 14 ∪ orSide6E = ofRows 0 0 [83886080, 92233720368832970752, 78398662365073637632, 4835707998230978276361152, 36267850789344570618447523, 1908931652715048442736807571, 1948199384398706554738509472, 52019910521581304108221376, 36297879674767169229422848, 4835703278458516698824704, 0, 0, 0, 335544320, 23058430092539592704, 13835058055416381440, 9223372036854775808, 0, 0, 0, 17179869184, 72057697117143040, 54043247068053504, 108086391056891904, 0, 0, 0, 0, 10995116277760, 716881581309952, 426610511577088, 281474976710656, 0, 0, 0, 0, 3298534883328, 6597069766656, 1099511627776] by
      rw [orGate_phase14, orSide6E, ofRows_eq_padRows' 0 0 0 0 0 0 _ (by norm_num) (by norm_num), ofRows_eq_padRows' 0 0 40 36 36 40 _ (by norm_num) (by norm_num), ← ofRows_orRows]; rfl,
    show orGate ∪ orSide6 = ofRows 0 0 [16777216, 73786976294859177984, 368934881525733797888, 455118177873004657149952, 644012837187738926121987, 1858139645101047596242387971, 1858223245745189647925969920, 1227889072522402593802240, 642241841670271749074944, 453347182355485948903424, 147573952589726744576, 110680464442282475520, 221360928884514619392, 0, 0, 0, 0, 5368709120, 1441151887201009664, 864691130602618880, 576460752303423488, 0, 0, 0, 274877906944, 4505248894812160, 3378524354248704, 6755399441055744, 0, 0, 0, 0, 52776558133248, 105553116266496, 17592186044416] by
      rw [orGate, orSide6, ofRows_eq_padRows' 0 0 0 0 0 0 _ (by norm_num) (by norm_num), ofRows_eq_padRows' 0 0 44 32 32 44 _ (by norm_num) (by norm_num), ← ofRows_orRows]; rfl]
  life_reaction

/-- The side input `orSide7`, `16` generations early. -/
