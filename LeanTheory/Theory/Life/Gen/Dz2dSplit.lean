/-- The tail of the run, from the cut, with the footprint of the tail. -/
theorem dz2dTailS (q : List (Salvo × ℤ)) (K Vs Vb Vs' : ℤ) (m0 : ℕ)
    (hv : DiagValid regParams Vs Vb K q)
    (hv' : DiagValid regParams Vs' Vb K (q ++ [(regPull, ((16 : ℤ) + (((m0 + 6555) / 4 : ℕ) : ℤ)))]))
    (hm : (m0 + 6555) % 4 = 0) (hVb : 18 ≤ Vb) (hVs : 18 ≤ Vs + 2 * ((m0 / 4 : ℕ) : ℤ))
    (hVs' : -34 ≤ Vs' + 2 * (((m0 + 6555) / 4 : ℕ) : ℤ)) :
    Reaction (Proc.start (dz2dL39 q K Vs Vb Vs' m0 hv hv')) (Proc.stop (dz2dL39 q K Vs Vb Vs' m0 hv hv')) 1987 (fun i => dz2dTailF (i + 0)) :=
  Reaction.castN
    ((Reaction.ofFootInT (o := 0) (dz2dSeg39 q K Vs Vb Vs' m0 hv hv' hm hVb hVs hVs') (dz2dFootS39 q K Vs Vb Vs' m0 hv hv' hm hVb hVs hVs')))
