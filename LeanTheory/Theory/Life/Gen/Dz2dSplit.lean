  have hY : ((dz2dRest ∪ conway.evolve (m0 + 11490) (diagW (q ++ [(regPull, ((16 : ℤ) + (((m0 + 6555) / 4 : ℕ) : ℤ)))]) K) : Finset Cell) : Set Cell) ⊆ dz2dRestRegion := by
    rw [← eY]
    exact (Proc.stop_subset_foot _).trans
      (Proc.foot_subset_of_footIn _ (dz2dFootRestS q K Vs Vb Vs' m0 hv hv' hm hVb hVs hVs') _ le_rfl)
  have hA : ((dz2dA123 : Finset Cell) : Set Cell) ⊆ dz2dAnsF (1987 + 0) := by
