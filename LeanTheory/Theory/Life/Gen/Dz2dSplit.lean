/-- **The rest of the run on its own**: after the cut, the circuit (and the register diagonal)
evolve inside `dz2dRestRegion`, and the end of the run is their end with the answer's. -/
theorem dz2dRestS (q : List (Salvo × ℤ)) (K Vs Vb Vs' : ℤ) (m0 : ℕ)
    (hv : DiagValid regParams Vs Vb K q)
    (hv' : DiagValid regParams Vs' Vb K (q ++ [(regPull, ((16 : ℤ) + (((m0 + 6555) / 4 : ℕ) : ℤ)))]))
    (hm : (m0 + 6555) % 4 = 0) (hVb : 18 ≤ Vb) (hVs : 18 ≤ Vs + 2 * ((m0 / 4 : ℕ) : ℤ))
    (hVs' : -34 ≤ Vs' + 2 * (((m0 + 6555) / 4 : ℕ) : ℤ)) :
    Reaction (Proc.start (dz2dLrestS q K Vs Vb Vs' m0 hv hv')) (conway.evolve 1987 (Proc.start (dz2dLrestS q K Vs Vb Vs' m0 hv hv')))
        1987 (fun _ => dz2dRestRegion) ∧
      Proc.stop (dz2dL39 q K Vs Vb Vs' m0 hv hv') = conway.evolve 1987 (Proc.start (dz2dLrestS q K Vs Vb Vs' m0 hv hv')) ∪ dz2dA123 := by
