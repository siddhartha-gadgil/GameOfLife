  exact ((h12.seq_const h34).seq_const h56).seq_const fanOut_part_7

/-! ### The whole assembly -/

set_option maxRecDepth 100000 in
/-- **The pull-salvo generator with a continue glider.** One control glider makes the assembly
`pullGenerator ∪ fanOut` emit the pulling salvo and the continue glider; after 2010 generations
the assembly is back in its cycle, and on the way everything stays in the box
`-479 ≤ x ≤ 90`, `-225 ≤ y ≤ 179`. -/
theorem continueGenerator_reaction :
    Reaction (pullGenerator ∪ fanOut ∪ cgControl)
      (pullGenerator ∪ translate (51, 143) pullSalvo ∪ fanOut ∪ contEnd) 2010
      (fun _ => Box (-479) 90 (-225) 179) := by
  -- phase 1: the fan-out works beside the generator at rest
  have h840 : conway.evolve 840 pullGenerator = pullGenerator :=
    conway.evolve_mul_of_evolve_eq pullGenerator_evolve_thirty 28
  have hR1 := (reaction_of_periodic (by norm_num) pullGenerator_evolve_thirty
    pullGenerator_subset_box 840).par fanOut_reaction
    (fun _ _ => Box.farApart (by omega))
  rw [h840] at hR1
  -- phase 2: the generator works beside the fan-out at rest and the continue glider in flight
  have h1170 : conway.evolve 1170 fanOut = fanOut :=
    conway.evolve_mul_of_evolve_eq fanOut_evolve_thirty 39
  have hC := reaction_flight_box' (by norm_num) contStart_evolve_four contStart_subset_box 1170
  have hFC := (reaction_of_periodic (by norm_num) fanOut_evolve_thirty fanOut_subset_box 1170).par
    hC (fun i _ => by
      rw [image_add_box]
      refine Box.farApart ?_
      simp only [Prod.smul_snd, nsmul_eq_mul]
      push_cast
      omega)
  have hR2 := pullGenerator_reaction.par hFC (fun i _ => by
    refine FarApart.union_right (Box.farApart (by omega)) ?_
    rw [image_add_box]
    refine Box.farApart ?_
    simp only [Prod.smul_fst, nsmul_eq_mul]
    push_cast
    omega)
  rw [h1170, contStart_evolve] at hR2
  have e1 : pullGenerator ∪ (fanOut ∪ pullGeneratorControl ∪ contStart) =
      pullGenerator ∪ pullGeneratorControl ∪ (fanOut ∪ contStart) :=
    union_rearrange _ _ _ _
  rw [e1] at hR1
  have e2 : pullGenerator ∪ fanOut ∪ cgControl = pullGenerator ∪ (fanOut ∪ cgControl) :=
    union_assoc _ _ _
  have e3 : pullGenerator ∪ translate (51, 143) pullSalvo ∪ fanOut ∪ contEnd =
      pullGenerator ∪ translate (51, 143) pullSalvo ∪ (fanOut ∪ contEnd) :=
    union_assoc _ _ _
  rw [e2, e3]
  refine (hR1.seq hR2).mono fun i hi => ?_
  split_ifs
  · exact Set.union_subset
      (box_subset_box (by norm_num) (by norm_num) (by norm_num) (by norm_num))
      (box_subset_box (by norm_num) (by norm_num) (by norm_num) (by norm_num))
  · refine Set.union_subset
      (box_subset_box (by norm_num) (by norm_num) (by norm_num) (by norm_num))
      (Set.union_subset
        (box_subset_box (by norm_num) (by norm_num) (by norm_num) (by norm_num)) ?_)
    rw [image_add_box]
    refine box_subset_box ?_ ?_ ?_ ?_ <;>
      simp only [Prod.smul_fst, Prod.smul_snd, nsmul_eq_mul] <;> push_cast <;> omega

/-- The result of the assembly, as an evolution. -/
theorem continueGenerator_evolve :
    conway.evolve 2010 (pullGenerator ∪ fanOut ∪ cgControl) =
      pullGenerator ∪ translate (51, 143) pullSalvo ∪ fanOut ∪ contEnd :=
  continueGenerator_reaction.evolve_eq

end LeanTheory.Life
