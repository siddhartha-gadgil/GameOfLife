/-!
# The increment: a generator of a pushing salvo

The counterpart of `Theory/Life/Decrement` (research note `N-15`): one control glider moves the
block of a register one step further away, for every position of the block. The design was
found by the project's own search (`scripts/life_machine`, report
`notes/research/reports/R-23-push-generator.md`, design `PSG1`).

* `pushSalvo3`: a three-glider salvo, found by the exhaustive search of `scripts/life_search`,
  that moves the block by `(1, 1)` (`push3_zero`, 32 generations). It is not `pushSalvo` of
  `Theory/Life/SlidingBlock`: of the pushing salvos found, only some can be assembled from
  reflected gliders, and this is one of them.
* `push3_reaction`: for every `k`, the salvo launched from its fixed place moves the block from
  `counter k` to `counter (k + 1)` in `k * 4 + 32` generations, staying in the rows `y ≥ -4`.
* `pushGenerator`: five blocked pairs of guns and four reflectors, period 30
  (`pushGenerator_evolve_thirty`). `pushGenerator_reaction`: one control glider gives, after 1650
  generations, the generator back in its cycle and the salvo `translate (84, 149) pushSalvo3`,
  inside the box `-89 ≤ x ≤ 93`, `-127 ≤ y ≤ 157` (certified in 11 parts).
* `increment`: for **every** `k`, the generator, one control glider and the register block
  `pushRegister k` evolve into the generator (in its cycle) and `pushRegister (k + 1)`, and
  nothing else.

**Sanity.** `pushGenerator_evolve_thirty` (without control nothing is emitted),
`increment_zero` (the instance `k = 0`).

Scope: the push generator serves its own block; serving the same block as `pullGenerator` needs a
joint design (report `R-23`, section 5).
-/

@[expose] public section

namespace LeanTheory.Life

open Finset

/-! ### The pushing salvo -/

/-- A three-glider salvo that pushes the block at `counter 0` to `counter 1`. -/
def pushSalvo3 : Finset Cell :=
  ofRows (-4) (-4) [640, 768, 256, 0, 0, 4, 5, 6, 0, 0, 4096, 8192, 14336]

/-- The salvo moves one cell down and to the right every four generations. -/
theorem pushSalvo3_evolve_four : conway.evolve 4 pushSalvo3 = translate (1, 1) pushSalvo3 := by
  rw [pushSalvo3, translate_ofRows]
  life_cert

/-- In its first four generations the salvo stays in the box `-4 ≤ x ≤ 10`, `-4 ≤ y ≤ 9`. -/
theorem pushSalvo3_subset_box (r : ℕ) (hr : r < 4) :
    (conway.evolve r pushSalvo3 : Set Cell) ⊆ Box (-4) 10 (-4) 9 := by
  interval_cases r <;> (life_eval; exact coe_ofRows_subset_box rfl)

set_option maxRecDepth 100000 in
/-- The salvo with the block at position `0`, as one window. -/
theorem pushSalvo3_union_counter_zero :
    pushSalvo3 ∪ counter 0 =
      ofRows (-4) (-4)
        [640, 768, 256, 0, 0, 4, 5, 6, 0, 0, 4096, 8192, 14336, 0, 0, 6144, 6144] := by
  rw [pushSalvo3, counter, ofRows_eq_padRows' (-4) (-4) (7 + 0) (11 + 0) 15 11 _ (by norm_num)
    (by norm_num), ← ofRows_orRows]
  rfl

/-- **Certificate**: the push at position `0` as a reaction, 32 generations, in a box. -/
theorem push3_zero_reaction :
    Reaction (pushSalvo3 ∪ counter 0) (counter 1) 32 (fun _ => Box (-4) 15 (-4) 15) := by
  rw [pushSalvo3_union_counter_zero, counter]
  life_reaction

/-- The push at position `0`. -/
theorem push3_zero : conway.evolve 32 (pushSalvo3 ∪ counter 0) = counter 1 :=
  push3_zero_reaction.evolve_eq

/-- `k • (1, 1)` is the cell `(k, k)`. -/
theorem nsmul_one_one (k : ℕ) : k • ((1, 1) : Cell) = ((k : ℤ), (k : ℤ)) := by
  ext <;> simp

/-- **The push, for every position**: the salvo launched from its fixed place moves the block
from position `k` to position `k + 1`, leaving nothing else, and stays in the rows `y ≥ -4`. -/
theorem push3_reaction (k : ℕ) :
    Reaction (pushSalvo3 ∪ counter k) (counter (k + 1)) (k * 4 + 32)
      (fun _ => {c : Cell | -4 ≤ c.2}) := by
  have hfly := (reaction_flight_box' (by norm_num) pushSalvo3_evolve_four pushSalvo3_subset_box
    (k * 4)).par ((counter_isStillLife k).reaction_box
      (fun c hc => by
        have h1 := le_of_mem_ofRows (mem_coe.1 hc)
        have h2 := snd_lt_of_mem_ofRows (mem_coe.1 hc)
        simp only [List.length_cons, List.length_nil] at h2
        exact (show c ∈ Box (7 + k) (8 + k) (11 + k) (12 + k) from ⟨h1.1, by
          have := fst_lt_of_mem_ofRows (w := 2) (by simp) (mem_coe.1 hc); omega, h1.2, by
          push_cast at h2; omega⟩)) (k * 4))
    (fun i hi => by
      rw [image_add_box]
      refine Box.farApart ?_
      simp only [Prod.smul_snd, nsmul_eq_mul]
      have : i / 4 < k := by omega
      push_cast
      omega)
  rw [conway.evolve_mul_of_evolve_eq_translate pushSalvo3_evolve_four, nsmul_one_one] at hfly
  have hz := push3_zero_reaction.translate ((k : ℤ), (k : ℤ))
  rw [translate_union, translate_counter, translate_counter, zero_add] at hz
  have e : (1 : ℤ) + k = k + 1 := by omega
  rw [e] at hz
  refine (hfly.seq hz).mono fun i _ => ?_
  split_ifs
  · refine Set.union_subset ?_ ?_
    · rintro _ ⟨c, hc, rfl⟩
      have h := hc.2.2.1
      change -4 ≤ ((i / 4) • ((1, 1) : Cell) + c).2
      simp only [Prod.snd_add, Prod.smul_snd, nsmul_eq_mul]
      push_cast
      omega
    · intro c hc
      have h := hc.2.2.1
      change -4 ≤ c.2
      omega
  · rintro _ ⟨c, hc, rfl⟩
    have h := hc.2.2.1
    change -4 ≤ (((k : ℤ), (k : ℤ)) + c).2
    simp only [Prod.snd_add]
    omega

