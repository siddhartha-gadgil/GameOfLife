/-- **The push generator.** One control glider makes it emit the pushing salvo; after 1650
generations it is back in its cycle, and on the way everything stays in the box
`-89 ≤ x ≤ 93`, `-127 ≤ y ≤ 157`. -/
theorem pushGenerator_reaction :
    Reaction (pushGenerator ∪ pushGeneratorControl)
      (pushGenerator ∪ translate (84, 149) pushSalvo3) 1650 (fun _ => Box (-89) 93 (-127) 157) := by
  rw [pushGenerator_union_control, pushGenerator_union_salvo]
  have h1 := pushGenerator_part_1.seq_const pushGenerator_part_2
  have h2 := h1.seq_const pushGenerator_part_3
  have h3 := h2.seq_const pushGenerator_part_4
  have h4 := h3.seq_const pushGenerator_part_5
  have h5 := h4.seq_const pushGenerator_part_6
  have h6 := h5.seq_const pushGenerator_part_7
  have h7 := h6.seq_const pushGenerator_part_8
  have h8 := h7.seq_const pushGenerator_part_9
  have h9 := h8.seq_const pushGenerator_part_10
  have h10 := h9.seq_const pushGenerator_part_11
  exact h10

/-! ### The increment -/

/-- The block of the register served by `pushGenerator`, at position `k`. -/
def pushRegister (k : ℤ) : Finset Cell := translate (84, 149) (counter k)

/-- **The increment as a reaction.** For every `k`: the push generator, one control glider and
the block at position `k` evolve into the generator (in its cycle) and the block at position
`k + 1`; on the way everything lies in the box of the generator or in the rows `y ≥ 145`. -/
theorem increment_reaction (k : ℕ) :
    Reaction (pushGenerator ∪ pushGeneratorControl ∪ pushRegister k)
      (conway.evolve (k * 4 + 32) pushGenerator ∪ pushRegister (k + 1)) (1650 + (k * 4 + 32))
      (fun _ => Box (-89) 93 (-127) 157 ∪ {c : Cell | 145 ≤ c.2}) := by
  have hblock : IsStillLife (pushRegister k) := (counter_isStillLife k).translate _
  have hrows : ∀ c ∈ pushRegister k, 160 + (k : ℤ) ≤ c.2 := by
    intro c hc
    rw [pushRegister, mem_translate] at hc
    have h := counter_snd k _ hc
    simp only [Prod.snd_sub] at h
    omega
  have hA := pushGenerator_reaction.par (hblock.reaction 1650) (fun _ _ a ha b hb hn => by
    have h1 := hrows b (mem_coe.1 hb)
    have h2 : a.2 ≤ 157 := ha.2.2.2
    obtain ⟨-, -, h4, -⟩ := hn
    push_cast at h4
    omega)
  have hS := (push3_reaction k).translate (84, 149)
  rw [translate_union] at hS
  have hR := reaction_of_periodic (by norm_num) pushGenerator_evolve_thirty
    pushGenerator_subset_box (k * 4 + 32)
  have hB := hR.par hS (fun _ _ a ha _ ⟨c, hc, hb⟩ hn => by
    subst hb
    have h1 : -4 ≤ c.2 := hc
    have h2 : a.2 ≤ 130 := ha.2.2.2
    obtain ⟨-, -, h4, -⟩ := hn
    simp only [Prod.snd_add] at h4
    push_cast at h4
    omega)
  have e : pushGenerator ∪ translate (84, 149) pushSalvo3 ∪ pushRegister k =
      pushGenerator ∪ (translate (84, 149) pushSalvo3 ∪ translate (84, 149) (counter k)) :=
    union_assoc _ _ _
  rw [e] at hA
  rw [show pushRegister ((k : ℤ) + 1) = translate (84, 149) (counter ((k : ℤ) + 1)) from rfl]
  refine (hA.seq hB).mono fun i _ => ?_
  split_ifs
  · refine Set.union_subset Set.subset_union_left fun c hc => Or.inr ?_
    have h := hrows c (mem_coe.1 hc)
    change 145 ≤ c.2
    omega
  · refine Set.union_subset ((box_subset_box (by norm_num) (by norm_num) (by norm_num)
      (by norm_num)).trans Set.subset_union_left) ?_
    rintro _ ⟨c, hc, rfl⟩
    refine Or.inr ?_
    have h : -4 ≤ c.2 := hc
    change 145 ≤ (((84 : ℤ), (149 : ℤ)) + c).2
    simp only [Prod.snd_add]
    omega

/-- **The increment.** For every position `k` of the block: one control glider sent into the push
generator moves the block from position `k` to position `k + 1`; the generator is left in its
cycle and nothing else remains. -/
theorem increment (k : ℕ) :
    conway.evolve (1650 + (k * 4 + 32)) (pushGenerator ∪ pushGeneratorControl ∪ pushRegister k) =
      conway.evolve (k * 4 + 32) pushGenerator ∪ pushRegister (k + 1) :=
  (increment_reaction k).evolve_eq

/-- **Sanity** (an instance): from position 0 the block is brought to position 1. -/
theorem increment_zero :
    conway.evolve 1682 (pushGenerator ∪ pushGeneratorControl ∪ pushRegister 0) =
      conway.evolve 32 pushGenerator ∪ pushRegister 1 :=
  increment 0

