/-- Two sets placed at module `r` far apart, from the sets far apart in the frame of the module. -/
theorem dsepT_modImg_far2 {r : ℕ} {A B : Set Cell} (h : FarApart 2 A B) :
    FarApart 2 (modImg p r A) (modImg p r B) := by
  rintro _ ⟨a, ha, rfl⟩ _ ⟨b, hb, rfl⟩ hn
  refine h a ha b hb ?_
  obtain ⟨n1, n2, n3, n4⟩ := hn
  simp only [Near, Prod.fst_add, Prod.snd_add] at *
  omega

/-- The station footprint of the NZ answer lies in the hulls of the stations `k < j`. -/
theorem dsepT_chainNZ_hull {j : ℕ} {c : Cell} (hc : c ∈ chainFoot stNZRY (72, 72) j) :
    ∃ k : ℤ, 0 ≤ k ∧ k < j ∧
      c ∈ Box (380 + 72 * k) (467 + 72 * k) (784 + 72 * k) (919 + 72 * k) := by
  obtain ⟨k, hk, hd⟩ := hc
  refine ⟨k, by omega, by omega, ?_⟩
  rcases hd with (((⟨h1, h2, h3, h4⟩ | ⟨h1, h2, h3, h4⟩) | ⟨h1, h2, h3, h4⟩) |
    ⟨m, m0, m1, h1, h2, h3, h4⟩) <;> simp only at h1 h2 h3 h4 <;>
    exact ⟨by omega, by omega, by omega, by omega⟩

/-- The station footprint of the Z answer lies in the hulls of the stations `k < j`. -/
theorem dsepT_chainZ_hull {j : ℕ} {c : Cell} (hc : c ∈ chainFoot stZR (72, -72) j) :
    ∃ k : ℤ, 0 ≤ k ∧ k < j ∧
      c ∈ Box (849 + 72 * k) (979 + 72 * k) (-385 - 72 * k) (-293 - 72 * k) := by
  obtain ⟨k, hk, hd⟩ := hc
  refine ⟨k, by omega, by omega, ?_⟩
  rcases hd with (((⟨h1, h2, h3, h4⟩ | ⟨h1, h2, h3, h4⟩) | ⟨h1, h2, h3, h4⟩) |
    ⟨m, m0, m1, h1, h2, h3, h4⟩) <;> simp only at h1 h2 h3 h4 <;>
    exact ⟨by omega, by omega, by omega, by omega⟩

/-- A region far from every station hull is far from the station footprint. -/
theorem dsepT_far_chainNZ {S : Set Cell} (j : ℕ)
    (h : ∀ k : ℤ, 0 ≤ k → FarApart 2 S (Box (380 + 72 * k) (467 + 72 * k) (784 + 72 * k)
      (919 + 72 * k))) : FarApart 2 S (chainFoot stNZRY (72, 72) j) := by
  intro a ha b hb
  obtain ⟨k, hk, -, hb⟩ := dsepT_chainNZ_hull hb
  exact h k hk a ha b hb

/-- A region far from every Z station hull is far from the Z station footprint. -/
theorem dsepT_far_chainZ {S : Set Cell} (j : ℕ)
    (h : ∀ k : ℤ, 0 ≤ k → FarApart 2 S (Box (849 + 72 * k) (979 + 72 * k) (-385 - 72 * k)
      (-293 - 72 * k))) : FarApart 2 S (chainFoot stZR (72, -72) j) := by
  intro a ha b hb
  obtain ⟨k, hk, -, hb⟩ := dsepT_chainZ_hull hb
  exact h k hk a ha b hb

/-- The NZ rest region is far from the station footprint of the NZ answer. -/
theorem dsepT_restNZ_chain (j : ℕ) :
    FarApart 2 (modImg p r decRestRegNZ) (modImg p r (chainFoot stNZRY (72, 72) j)) := by
  refine dsepT_modImg_far2 (dsepT_far_chainNZ j fun k hk => ?_)
  unfold decRestRegNZ
  intro a ha
  simp only [unionL, Set.mem_union] at ha
  rcases ha with ha | ha | ha | ha | ha | ha | ha | ha | ha | ha | ha | ha
  · exact dsepT_dz2dRestRegL_st k hk a ha
  · exact dsepT_dz2d1RestRegL_st k hk a ha
  · exact dsepT_dz2d2RestRegL_st k hk a ha
  · exact dsepT_dz2d3RestRegL_st k hk a ha
  · exact dsepT_dz2mk1RestRegL_st k hk a ha
  · exact dsepT_dz2mk2RestRegL_st k hk a ha
  · exact dsepT_dz2mk3RestRegL_st k hk a ha
  · exact dsepT_dz2mk4RestRegL_st k hk a ha
  · exact dsepT_dz2mk5RestRegL_st k hk a ha
  · exact dsepT_dz2mk6RestRegL_st k hk a ha
  · exact dsepT_dz2mk7RestRegL_st k hk a ha
  · exact ha.elim

/-- The NZ answer after the cut lies in the moving box of the certificates (module frame). -/
theorem dsepT_ansN_sub (hi : p[i]? = some (.decJz r z)) {t : ℕ} (ht : decCutN p i r ≤ t) :
    (decAnsWLN p i r).box t ⊆
      modImg p r (Box (104 + (((t - decCutN p i r) / 4 : ℕ) : ℤ))
        (111 + (((t - decCutN p i r) / 4 : ℕ) : ℤ)) (495 + (((t - decCutN p i r) / 4 : ℕ) : ℤ))
        (502 + (((t - decCutN p i r) / 4 : ℕ) : ℤ))) := by
  have hu := modD_uv p r
  obtain ⟨hTS, -, -⟩ := decTS_facts p hi
  rintro x ⟨x1, x2, x3, x4⟩
  refine ⟨x - (modDX p r, modDY p r), ?_, by ext <;> simp⟩
  simp only [decAnsWLN, modWL, ansNZWL, WL.shift, WL.px, WL.py, WL.qt] at x1 x2 x3 x4
  simp only [decCutN] at ht ⊢
  refine ⟨?_, ?_, ?_, ?_⟩ <;> simp only [Prod.fst_sub, Prod.snd_sub] <;> omega

/-- The NZ rest region is far from the NZ answer after the cut. -/
theorem dsepT_restNZ_ans (hi : p[i]? = some (.decJz r z)) {t : ℕ} (ht : decCutN p i r ≤ t) :
    FarApart 2 (modImg p r decRestRegNZ) ((decAnsWLN p i r).box t) := by
  refine FarApart.mono ?_ le_rfl (dsepT_ansN_sub hi ht)
  refine dsepT_modImg_far2 ?_
  unfold decRestRegNZ
  intro a ha
  simp only [unionL, Set.mem_union] at ha
  rcases ha with ha | ha | ha | ha | ha | ha | ha | ha | ha | ha | ha | ha
  · exact fun b hb => dz2dAnsFar (t - decCutN p i r) a ha b (by simpa [dz2dAnsF] using hb)
  · exact fun b hb => dz2d1AnsFar (t - decCutN p i r) a ha b (by simpa [dz2d1AnsF] using hb)
  · exact fun b hb => dz2d2AnsFar (t - decCutN p i r) a ha b (by simpa [dz2d2AnsF] using hb)
  · exact fun b hb => dz2d3AnsFar (t - decCutN p i r) a ha b (by simpa [dz2d3AnsF] using hb)
  · exact fun b hb => dz2mk1AnsFar (t - decCutN p i r) a ha b (by simpa [dz2mk1AnsF] using hb)
  · exact fun b hb => dz2mk2AnsFar (t - decCutN p i r) a ha b (by simpa [dz2mk2AnsF] using hb)
  · exact fun b hb => dz2mk3AnsFar (t - decCutN p i r) a ha b (by simpa [dz2mk3AnsF] using hb)
  · exact fun b hb => dz2mk4AnsFar (t - decCutN p i r) a ha b (by simpa [dz2mk4AnsF] using hb)
  · exact fun b hb => dz2mk5AnsFar (t - decCutN p i r) a ha b (by simpa [dz2mk5AnsF] using hb)
  · exact fun b hb => dz2mk6AnsFar (t - decCutN p i r) a ha b (by simpa [dz2mk6AnsF] using hb)
  · exact fun b hb => dz2mk7AnsFar (t - decCutN p i r) a ha b (by simpa [dz2mk7AnsF] using hb)
  · exact ha.elim

/-- A set far from both parts of a union. -/
theorem dsepT_far_union_r {A B C : Set Cell} (h1 : FarApart 2 A B) (h2 : FarApart 2 A C) :
    FarApart 2 A (B ∪ C) := fun x hx y hy => hy.elim (h1 x hx y) (h2 x hx y)

/-- Two distinct pieces of the machine are separated. -/
theorem dsepT_sep_of_ne (hp : p.WellFormed) {g h : Piece} (hg : g ∈ machPieces p)
    (hh : h ∈ machPieces p) (hne : g ≠ h) : FarApart 2 g.box h.box := by
  have : Std.Symm Piece.Sep := ⟨fun _ _ h => Piece.Sep.symm' h⟩
  exact (machPieces_sep p hp).forall hg hh hne

/-- The circuit and the lanes of register `r` are far from the pieces of the machine outside the
circuit. -/
theorem dsepT_grpLanes_far (hp : p.WellFormed) (hr : r < numRegs p) {g : Piece}
    (hg : g ∈ machPieces p) (hn : g ∉ modGroup p r) :
    FarApart 2 (boxesOf (modGroup p r) ∪ modLanes p r) g.box := by
  refine dsepT_far_union ?_ ((machBoxes_far hp r).symm'.mono le_rfl
    (fun x hx => mem_boxesOf.2 ⟨g, hg, hx⟩))
  refine (farApart_boxesOf fun h hh => ?_).symm'
  exact dsepT_sep_of_ne hp hg (modGroup_mem hr h hh) fun e => hn (e ▸ hh)

/-- The circuit and the lanes of register `r` are far from the station footprint of the NZ
answer. -/
theorem dsepT_grpLanes_chainNZ (j : ℕ) :
    FarApart 2 (boxesOf (modGroup p r) ∪ modLanes p r)
      (modImg p r (chainFoot stNZRY (72, 72) j)) := by
  have hu := modD_uv p r
  refine dsepT_far_union ?_ ?_
  · refine (farApart_boxesOf fun h hh => ?_).symm'
    refine dsepT_far_cells fun a ha b hb => ?_
    have := dsepT_chainNZ_up ha
    have := dsepT_grp_cells hh b hb
    simp only [dsepTGrpHull] at this
    omega
  · rintro _ ⟨c, ⟨c1, c2, c3⟩, rfl⟩ _ ⟨d, hd, rfl⟩ hn
    obtain ⟨k, hk, -, d1, d2, d3, d4⟩ := dsepT_chainNZ_hull hd
    obtain ⟨n1, n2, n3, n4⟩ := hn
    simp only [Prod.fst_add, Prod.snd_add] at *
    omega

/-- **`DecSep.nQ3a`**: after the cut, the rest of the NZ run is far from the stations
`0 … j - 1` and from the answer. -/
theorem dsepT_nQ3a (hp : p.WellFormed) (hi : p[i]? = some (.decJz r z)) :
    ∀ t : ℕ, decCutN p i r ≤ t → t < decCapN p i r →
      FarApart 2 (restFootN p i r t) (boxesOf (decLSN p i r) ∪ decAnsFootN p i r t) := by
  intro t h1 h2
  have hr := lt_numRegs_of_dec hi
  unfold restFootN
  split_ifs with hR
  · refine dsepT_far_union_r (farApart_boxesOf fun g hg =>
      dsepT_restNZ_far hp hr g (decLSN_mem hi g hg) (dsepT_LSN_not_grp hi g hg)) ?_
    unfold decAnsFootN
    split_ifs
    · exact dsepT_restNZ_ans hi h1
    · exact dsepT_restNZ_chain _
  · refine dsepT_far_union_r (farApart_boxesOf fun g hg =>
      dsepT_grpLanes_far hp hr (decLSN_mem hi g hg) (dsepT_LSN_not_grp hi g hg)) ?_
    unfold decAnsFootN
    split_ifs with hS
    · exfalso
      simp only [decRunEndN, decSt0N] at hR hS
      omega
    · exact dsepT_grpLanes_chainNZ _

/-- The Z answer after the cut lies in the moving box of the certificate (module frame). -/
theorem dsepT_ansZ_sub (hi : p[i]? = some (.decJz r z)) {t : ℕ} (ht : decCutZ p i r ≤ t) :
    (decAnsWLZ p i r).box t ⊆
      modImg p r (Box (673 + (((t - decCutZ p i r) / 4 : ℕ) : ℤ))
        (680 + (((t - decCutZ p i r) / 4 : ℕ) : ℤ)) (-142 - (((t - decCutZ p i r) / 4 : ℕ) : ℤ))
        (-135 - (((t - decCutZ p i r) / 4 : ℕ) : ℤ))) := by
  have hu := modD_uv p r
  obtain ⟨hTS, -, -⟩ := decTS_facts p hi
  rintro x ⟨x1, x2, x3, x4⟩
  refine ⟨x - (modDX p r, modDY p r), ?_, by ext <;> simp⟩
  simp only [decAnsWLZ, modWL, ansZWL, WL.shift, WL.px, WL.py, WL.qt] at x1 x2 x3 x4
  simp only [decCutZ] at ht ⊢
  refine ⟨?_, ?_, ?_, ?_⟩ <;> simp only [Prod.fst_sub, Prod.snd_sub] <;> omega

/-- The Z stations are not the INC gate nor groups of the circuit. -/
theorem dsepT_LSZ_not_gate (hi : p[i]? = some (.decJz r z)) :
    ∀ g ∈ decLSZ p i r, g ∉ modGroup p r ++ [gateP p r] := by
  intro g hg hm
  rcases List.mem_append.1 hm with hm | hm
  · exact dsepT_LSZ_not_grp hi g hg hm
  · rw [List.mem_singleton.1 hm] at hg
    have hu := modD_uv p r
    have := (dsepT_LSZ_up hg (modDX p r - 1132, modDY p r - 1291) (by
      simp only [gateP, incGateSpec, PSpec.piece, Piece.place, Piece.box, Box, Base.piece,
        orGateP, Set.mem_ofPred_eq]
      omega)).2
    simp only at this
    omega

/-- **`DecSep.zQ3a`**: after the cut, the rest of the zero test is far from the Z stations
`0 … j - 1` and from the answer. -/
theorem dsepT_zQ3a (hp : p.WellFormed) (hi : p[i]? = some (.decJz r z)) :
    ∀ t : ℕ, decCutZ p i r ≤ t → t < decCapZ p i r →
      FarApart 2 (restFootZ p i r t) (boxesOf (decLSZ p i r) ∪ decAnsFootZ p i r t) := by
  intro t h1 h2
  have hr := lt_numRegs_of_dec hi
  have hu := modD_uv p r
  unfold restFootZ
  split_ifs with hR
  · refine dsepT_far_union_r (farApart_boxesOf fun g hg =>
      dsepT_restZ_far hp hr g (decLSZ_mem hi g hg) (dsepT_LSZ_not_gate hi g hg)) ?_
    unfold decAnsFootZ
    split_ifs
    · refine FarApart.mono ?_ le_rfl (dsepT_ansZ_sub hi h1)
      refine dsepT_modImg_far2 fun a ha b hb => dz2mk0AnsFar (t - decCutZ p i r) a ha b ?_
      simpa [dz2mk0AnsF, sub_eq_add_neg] using hb
    · exact dsepT_modImg_far2 (dsepT_far_chainZ _ fun k hk => dsepT_dz2mk0RestRegL_st k hk)
  · refine dsepT_far_union_r (farApart_boxesOf fun g hg =>
      dsepT_grpLanes_far hp hr (decLSZ_mem hi g hg) (dsepT_LSZ_not_grp hi g hg)) ?_
    unfold decAnsFootZ
    split_ifs with hS
    · exfalso
      simp only [decRunEndZ, decSt0Z] at hR hS
      omega
    · refine dsepT_far_union ?_ ?_
      · refine (farApart_boxesOf fun h hh => ?_).symm'
        refine dsepT_far_cells fun a ha b hb => ?_
        obtain ⟨d, hd, rfl⟩ := ha
        obtain ⟨k, hk, -, d1, d2, d3, d4⟩ := dsepT_chainZ_hull hd
        have := dsepT_grp_cells hh b hb
        simp only [dsepTGrpHull, Prod.fst_add, Prod.snd_add] at *
        omega
      · rintro _ ⟨c, ⟨c1, c2, c3⟩, rfl⟩ _ ⟨d, hd, rfl⟩ hn
        obtain ⟨k, hk, -, d1, d2, d3, d4⟩ := dsepT_chainZ_hull hd
        obtain ⟨n1, n2, n3, n4⟩ := hn
        simp only [Prod.fst_add, Prod.snd_add] at *
        omega

end LP

