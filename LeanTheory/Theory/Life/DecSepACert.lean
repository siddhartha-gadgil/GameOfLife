/-- **The joint approach of the line NZ stays in two boxes** (station frame), away from the
pieces of the previous station. -/
theorem dsepA_winN_foot : ∀ k < 90, (conway.evolve k (stCaptureNZG ∪ stTokENZ) : Set Cell) ⊆
    Box 362 467 846 919 ∪ Box 372 467 820 919 := by
  intro k hk
  have hK : (tokNZWL 0).Dir := ⟨Or.inl rfl, Or.inr rfl⟩
  have hE : stTokENZ = (tokNZWL 0).cells 10260 := rfl
  have hG : stCaptureNZG = phase stNZG 0 := by
    rw [stCaptureNZG_eq, phase, Nat.zero_mod, Rule.evolve_zero]
  have W1 := (phase_reaction stNZG_rest 0 44).par (WL.flight hK 10260 44) fun i hi => by
    rintro a ha b ⟨b1, b2, b3, b4⟩ ⟨n1, n2, n3, n4⟩
    simp only [tokNZWL, WL.px, WL.py, WL.qt] at b1 b2 b3 b4
    push_cast at b1 b2 b3 b4
    rcases ha with (⟨a1, a2, a3, a4⟩ | ⟨a1, a2, a3, a4⟩) | ⟨a1, a2, a3, a4⟩ <;> omega
  rw [← hG, ← hE] at W1
  by_cases h44 : k ≤ 44
  · refine (W1.subset k h44).trans ?_
    rintro c (((⟨c1, c2, c3, c4⟩ | ⟨c1, c2, c3, c4⟩) | ⟨c1, c2, c3, c4⟩) | ⟨c1, c2, c3, c4⟩)
    · exact Or.inr ⟨by omega, by omega, by omega, by omega⟩
    · exact Or.inr ⟨by omega, by omega, by omega, by omega⟩
    · exact Or.inr ⟨by omega, by omega, by omega, by omega⟩
    · simp only [tokNZWL, WL.px, WL.py, WL.qt] at c1 c2 c3 c4
      push_cast at c1 c2 c3 c4
      exact Or.inl ⟨by omega, by omega, by omega, by omega⟩
  · have e : k = (k - 44) + 44 := by omega
    rw [e, Rule.evolve_add, dsepAStartN_eq, dsepAMidN_eq]
    exact (dsepA_tailN.subset (k - 44) (by omega)).trans Set.subset_union_right

/-- **The joint approach of the line Z stays in two boxes** (station frame), away from the pieces
of the previous station. -/
theorem dsepA_winZ_foot : ∀ k < 90, (conway.evolve k (stCaptureZG ∪ stTokEZ) : Set Cell) ⊆
    Box 880 979 (-380) (-286) ∪ Box 940 950 (-290) (-279) := by
  intro k hk
  have hK : (tokZWL 0).Dir := ⟨Or.inr rfl, Or.inr rfl⟩
  have hE : stTokEZ = (tokZWL 0).cells 12300 := rfl
  have hG : stCaptureZG = phase stZG 0 := by
    rw [stCaptureZG_eq, phase, Nat.zero_mod, Rule.evolve_zero]
  have W1 := (phase_reaction stZG_rest 0 24).par (WL.flight hK 12300 24) fun i hi => by
    rintro a ha b ⟨b1, b2, b3, b4⟩ ⟨n1, n2, n3, n4⟩
    simp only [tokZWL, WL.px, WL.py, WL.qt] at b1 b2 b3 b4
    push_cast at b1 b2 b3 b4
    rcases ha with (⟨a1, a2, a3, a4⟩ | ⟨a1, a2, a3, a4⟩) | ⟨a1, a2, a3, a4⟩ <;> omega
  rw [← hG, ← hE] at W1
  by_cases h24 : k ≤ 24
  · refine (W1.subset k h24).trans ?_
    rintro c (((⟨c1, c2, c3, c4⟩ | ⟨c1, c2, c3, c4⟩) | ⟨c1, c2, c3, c4⟩) | ⟨c1, c2, c3, c4⟩)
    · exact Or.inl ⟨by omega, by omega, by omega, by omega⟩
    · exact Or.inl ⟨by omega, by omega, by omega, by omega⟩
    · exact Or.inl ⟨by omega, by omega, by omega, by omega⟩
    · simp only [tokZWL, WL.px, WL.py, WL.qt] at c1 c2 c3 c4
      push_cast at c1 c2 c3 c4
      exact Or.inr ⟨by omega, by omega, by omega, by omega⟩
  · have e : k = (k - 24) + 24 := by omega
    rw [e, Rule.evolve_add, dsepAStartZ_eq, dsepAMidZ_eq]
    exact (dsepA_tailZ.subset (k - 24) (by omega)).trans Set.subset_union_left

