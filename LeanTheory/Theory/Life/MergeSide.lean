/-- **The merge chain entered from the side** (residue 5): the side input of the first of
`L + 2` OR gates is carried to the place of the input of a copy number `L + 2`. -/
theorem orChainSide5 (L : ℕ) :
    Reaction (relayChain orGate 254 (35, 64) (L + 2) 0 ∪ orSide5)
      (phase orGate (134 + (L + 1) * 254) ∪ translate (35, 64) (relayChain orGate 254 (35, 64) (L + 1)
        ((L + 1) * 254) ∪ translate (((L + 1 : ℕ) : ℤ) * (35, 64).1, ((L + 1 : ℕ) : ℤ) * (35, 64).2) orIn))
      (134 + (L + 1) * 254) (fun _ => chainFoot (Box 0 90 (-6) 60) (35, 64) (L + 2)) :=
  chain_side_reaction orGate_rest orGate_relay orGate_side5 (by norm_num)
    (fun _ ⟨h1, h2, h3, h4⟩ => ⟨h1, h2, by omega, by omega⟩)
    (fun _ ⟨h1, h2, h3, h4⟩ => ⟨by omega, by omega, by omega, by omega⟩)
    (by norm_num) (by norm_num) (by norm_num) (by norm_num) (by norm_num) L

