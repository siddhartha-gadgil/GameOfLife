/-- **Fan-out, phase 1**: the control glider of the push generator is emitted. -/
theorem pushFan_phase1 :
    Reaction (pushFan ∪ pushFanControl) (pushFanMid ∪ pushGeneratorControl) 450
      (fun _ => Box (-126) (-3) (-248) (-125)) := by
  rw [pushFan_union_control, pushFanMid_union_output]
  exact (pushFan_part_1.seq_const pushFan_part_2).seq_const pushFan_part_3

set_option maxRecDepth 100000 in
/-- **Fan-out, phase 2**: the fan-out finishes its reaction and emits the continue glider; all
cells stay left of or above the generator's box. -/
theorem pushFan_phase2 :
    Reaction pushFanMid (pushFan ∪ pushCont) 450
      (fun _ => {c : Cell | c.1 ≤ -92 ∨ c.2 ≤ -130}) := by
  have hinv : ∀ i ≤ 450, ∀ c ∈ conway.evolve i pushFanMid, c.1 ≤ -92 ∨ c.2 ≤ -130 := by
    rw [pushFanMid]
    life_corner
  refine ⟨?_, fun i hi c hc => hinv i hi c (mem_coe.1 hc)⟩
  rw [pushFan_union_cont, pushFanMid]
  life_cert

/-! ### The whole assembly -/

set_option maxRecDepth 100000 in
/-- **The push generator with a continue glider.** One control glider makes the assembly
`pushGenerator ∪ pushFan` emit the pushing salvo and a continue glider; after 2100 generations
the assembly is back in its cycle. -/
theorem incrementContinue_evolve :
    conway.evolve 2100 (pushGenerator ∪ pushFan ∪ pushFanControl) =
      pushGenerator ∪ translate (84, 149) pushSalvo3 ∪ (pushFan ∪ pushContEnd) := by
  -- phase 1: the fan-out emits the generator's control glider beside the resting generator
  have h450 : conway.evolve 450 pushGenerator = pushGenerator :=
    conway.evolve_mul_of_evolve_eq pushGenerator_evolve_thirty 15
  have h1 := (reaction_of_periodic (by norm_num) pushGenerator_evolve_thirty
    pushGenerator_subset_box 450).par pushFan_phase1 (fun _ _ => Box.farApart (by omega))
  rw [h450] at h1
  -- phase 2: the generator starts, the fan-out finishes
  have hfirst :=
    (pushGenerator_part_1.seq_const pushGenerator_part_2).seq_const pushGenerator_part_3
  rw [← pushGenerator_union_control] at hfirst
  have h2 := hfirst.par pushFan_phase2 (fun _ _ a ha b hb hn => by
    have h1 := ha.1
    have h2 := ha.2.2.1
    obtain ⟨-, n2, -, n4⟩ := hn
    rcases hb with hb | hb
    · push_cast at n2; omega
    · push_cast at n4; omega)
  -- phase 3: the generator finishes beside the resting fan-out and the continue glider
  have h45 := pushGenerator_part_4.seq_const pushGenerator_part_5
  have h67 := pushGenerator_part_6.seq_const pushGenerator_part_7
  have h89 := pushGenerator_part_8.seq_const pushGenerator_part_9
  have h1011 := pushGenerator_part_10.seq_const pushGenerator_part_11
  have hrest := ((h45.seq_const h67).seq_const h89).seq_const h1011
  rw [← pushGenerator_union_salvo] at hrest
  have h1200 : conway.evolve 1200 pushFan = pushFan :=
    conway.evolve_mul_of_evolve_eq pushFan_evolve_thirty 40
  have hc := reaction_flight_box' (by norm_num) pushCont_evolve_four pushCont_subset_box 1200
  have hFC := (reaction_of_periodic (by norm_num) pushFan_evolve_thirty pushFan_subset_box
    1200).par hc (fun i _ => by
      rw [image_add_box]
      refine Box.farApart ?_
      simp only [Prod.smul_fst, nsmul_eq_mul]
      push_cast
      omega)
  have h3 := hrest.par hFC (fun i _ => by
    rw [image_add_box]
    simp only [Prod.smul_fst, Prod.smul_snd, nsmul_eq_mul]
    push_cast
    exact FarApart.union_right (Box.farApart (by omega)) (Box.farApart (by omega)))
  rw [h1200, pushCont_evolve] at h3
  have e1 : pushGenerator ∪ (pushFanMid ∪ pushGeneratorControl) =
      pushGenerator ∪ pushGeneratorControl ∪ pushFanMid := by
    rw [union_comm pushFanMid, ← union_assoc]
  rw [e1] at h1
  have hAll := (h1.seq h2).seq h3
  rw [← union_assoc pushGenerator pushFan pushFanControl] at hAll
  exact hAll.evolve_eq

end LeanTheory.Life
