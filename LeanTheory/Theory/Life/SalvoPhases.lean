module

public import LeanTheory.Theory.Life.Salvos

/-!
# The salvos at every phase

A salvo has period four; the register operations of the machine are started at times fixed only
modulo `30`, so a salvo joins a register diagonal at any of its four phases. `regPull` and
`regPush` (`Theory/Life/Salvos`) are phase `0`; here phases `1, 2, 3` as `Salvo`s
(`regPullP1` … `regPushP3`). Generated by `scripts/life_cert/salvo_phases.py` (untrusted);
everything is checked here.
-/

set_option linter.style.longLine false

@[expose] public section

namespace LeanTheory.Life

open Finset

/-- The pulling salvo at phase 1. -/
def regPullP1S : Finset Cell := ofRows (-1) 5 [4, 261, 1542, 768]

/-- The pulling salvo at phase 1 moves by `(1, 1)` every four generations. -/
theorem regPullP1S_four : conway.evolve 4 regPullP1S = translate (1, 1) regPullP1S := by
  rw [regPullP1S, translate_ofRows]
  life_cert

/-- The pulling salvo at phase 1 during four generations. -/
theorem regPullP1S_box : ∀ r < 4, (conway.evolve r regPullP1S : Set Cell) ⊆ Box (-1) 9 5 9 := by
  intro r hr
  interval_cases r <;> (rw [regPullP1S]; life_eval; exact coe_ofRows_subset_box rfl)

set_option maxRecDepth 100000 in
/-- **Certificate**: the pulling salvo at phase 1 moves the block at position `0`. -/
theorem regPullP1S_hz : Reaction (regPullP1S ∪ counter 0) (counter (-1)) 28 (fun _ => Box (-1) 14 4 12) := by
  rw [show regPullP1S ∪ counter 0 = ofRows (-1) 5 [4, 261, 1542, 768, 0, 0, 768, 768] by
      rw [regPullP1S, counter, ofRows_eq_padRows' (-1) 5 (-1) 5 0 0 _ (by norm_num) (by norm_num),
        ofRows_eq_padRows' (-1) 5 (7 + 0) (11 + 0) 6 8 _ (by norm_num) (by norm_num), ← ofRows_orRows]
      rfl,
    show counter (-1) = ofRows 6 10 [3, 3] by rw [counter]; norm_num]
  life_reaction

/-- The pulling salvo at phase 1 as a `Salvo` (reaction prolonged to 28 generations). -/
def regPullP1 : Salvo where
  S := regPullP1S
  d := -1
  n := 28
  a := (-1)
  b := 9
  lo := 5
  hi := 9
  za := (-1)
  zb := 14
  zlo := 4
  zhi := 12
  four := regPullP1S_four
  box := regPullP1S_box
  hz := regPullP1S_hz.extend_still (counter_isStillLife _) 0
  hhi := by norm_num

